import Proofs.QMClosure.AllocatedPreparation
import Proofs.QMClosure.ResponseContextQuotient

/-!
# Context tests on explicitly allocated generated values

For an arbitrary raw operation, chosen zero, and admitted stock, the generated
carrier consists exactly of selected values of allocated finite preparations.
Both outputs preserve this carrier. Every finite context over it lifts to a
context of preparations, and literal compiled signature tests are equivalent
to response equivalence on this carrier.

No ambient preparation completeness, square, mediality, topology, probability,
or uniform resource ceiling is assumed. Common-frame joint arrays and their
resources remain supplied: these theorems establish neither physical
availability, independence, tensor structure, unknown-token cloning, automatic
probability-law descent, outcome actualization, nor QM closure.
-/

namespace IDT.QMClosure.AllocatedGeneratedContexts

noncomputable section

open OperationalContextQuotient
open NativeRecipeContextRealization (mapRefs)
open AllocatedPreparation (Program eval pair realize budget referenceBudget)
open ResponseContextQuotient (ResponseEq)

variable {S V Ω : Type*}

/-- Structural reference substitution lifts surjections without changing the hole. -/
theorem mapRefs_surjective {A B : Type*} (f : A → B)
    (hf : Function.Surjective f) : Function.Surjective (mapRefs f) := by
  intro C
  induction C with
  | hole => exact ⟨.hole, rfl⟩
  | left o c r ih =>
    obtain ⟨d, hd⟩ := ih
    obtain ⟨s, hs⟩ := hf r
    exact ⟨.left o d s, by simp only [mapRefs, hd, hs]⟩
  | right o r c ih =>
    obtain ⟨s, hs⟩ := hf r
    obtain ⟨d, hd⟩ := ih
    exact ⟨.right o s d, by simp only [mapRefs, hs, hd]⟩

theorem mapRefs_comp {A B C : Type*} (f : A → B) (g : B → C)
    (c : Context A) : mapRefs g (mapRefs f c) = mapRefs (g ∘ f) c := by
  induction c with
  | hole => rfl
  | left o c r ih => simp only [mapRefs, ih, Function.comp_apply]
  | right o r c ih => simp only [mapRefs, ih, Function.comp_apply]

variable (T : V × V → V × V) (zero : V) (stock : S → V)

/-- Existential selected-value reachability, retaining the full recipe as witness. -/
def Generated (x : V) : Prop := ∃ p : Program S, eval T zero stock p = x

def G := {x : V // Generated T zero stock x}

/-- A preparation denotes its selected generated value. -/
def value (p : Program S) : G T zero stock :=
  ⟨eval T zero stock p, ⟨p, rfl⟩⟩

@[simp] theorem val_value (p : Program S) :
    (value T zero stock p).val = eval T zero stock p := rfl

theorem value_surjective : Function.Surjective (value T zero stock) := by
  intro x
  obtain ⟨p, hp⟩ := x.property
  exact ⟨p, Subtype.ext hp⟩

/-- A witness choice is used only for closure, never as a canonical history. -/
def recipe (x : G T zero stock) : Program S := Classical.choose x.property

theorem eval_recipe (x : G T zero stock) :
    eval T zero stock (recipe T zero stock x) = x.val :=
  Classical.choose_spec x.property

/-- Both ordered outputs are generated by disjointly allocated input recipes. -/
def outputG (o : Output) (x y : G T zero stock) : G T zero stock :=
  ⟨select o (T (x.val, y.val)),
    ⟨pair o (recipe T zero stock x) (recipe T zero stock y), by
      rw [AllocatedPreparation.eval_pair, eval_recipe, eval_recipe]⟩⟩

def operationG (p : G T zero stock × G T zero stock) :
    G T zero stock × G T zero stock :=
  (outputG T zero stock .first p.1 p.2,
    outputG T zero stock .second p.1 p.2)

@[simp] theorem val_outputG (o : Output) (x y : G T zero stock) :
    (outputG T zero stock o x y).val = select o (T (x.val, y.val)) := rfl

@[simp] theorem val_select_operationG (o : Output) (x y : G T zero stock) :
    (select o (operationG T zero stock (x, y))).val =
      select o (T (x.val, y.val)) := by
  cases o <;> rfl

def zeroG : G T zero stock := value T zero stock AllocatedPreparation.zeroProgram

def sourceG (s : S) : G T zero stock :=
  value T zero stock (AllocatedPreparation.sourceProgram s)

@[simp] theorem val_zeroG : (zeroG T zero stock).val = zero := rfl

@[simp] theorem val_sourceG (s : S) :
    (sourceG T zero stock s).val = stock s := rfl

def signatureG (signature : V → Ω) : G T zero stock → Ω :=
  fun x => signature x.val

/-- Generated-carrier evaluation is literal ambient evaluation after coercion. -/
theorem eval_coe (C : Context (G T zero stock)) (x : G T zero stock) :
    (Context.eval (operationG T zero stock) C x).val =
      Context.eval T (mapRefs Subtype.val C) x.val := by
  induction C with
  | hole => rfl
  | left o c r ih =>
    change (select o (operationG T zero stock
      (Context.eval (operationG T zero stock) c x, r))).val = _
    rw [val_select_operationG, ih]
    rfl
  | right o r c ih =>
    change (select o (operationG T zero stock
      (r, Context.eval (operationG T zero stock) c x))).val = _
    rw [val_select_operationG, ih]
    rfl

/-- Every carrier context has a preparation context with the same finite shape. -/
theorem context_lift (C : Context (G T zero stock)) :
    ∃ D : Context (Program S), mapRefs (value T zero stock) D = C :=
  mapRefs_surjective (value T zero stock) (value_surjective T zero stock) C

/-- No program evaluator over the generated carrier is needed for this bridge. -/
theorem eval_mapped_value (C : Context (Program S)) (p : Program S) :
    (Context.eval (operationG T zero stock)
      (mapRefs (value T zero stock) C) (value T zero stock p)).val =
        eval T zero stock (realize C p) := by
  rw [eval_coe, AllocatedPreparation.eval_realize]
  have href : mapRefs (fun x : G T zero stock => x.val)
      (mapRefs (value T zero stock) C) = mapRefs (eval T zero stock) C := by
    induction C with
    | hole => rfl
    | left o c r ih => simp only [mapRefs, val_value, ih]
    | right o r c ih => simp only [mapRefs, val_value, ih]
  exact congrArg (fun D : Context V => Context.eval T D (eval T zero stock p)) href

/-- Literal finite recipe tests are exactly response equivalence on the
generated carrier, for any supplied ambient response signature. -/
theorem compiled_tests_iff_responseEq (signature : V → Ω) (p q : Program S) :
    (∀ C : Context (Program S),
      signature (eval T zero stock (realize C p)) =
        signature (eval T zero stock (realize C q))) ↔
      ResponseEq (operationG T zero stock) (signatureG T zero stock signature)
        (value T zero stock p) (value T zero stock q) := by
  constructor
  · intro h C
    obtain ⟨D, hD⟩ := context_lift T zero stock C
    rw [← hD]
    change signature ((Context.eval (operationG T zero stock)
      (mapRefs (value T zero stock) D) (value T zero stock p)).val) =
        signature ((Context.eval (operationG T zero stock)
          (mapRefs (value T zero stock) D) (value T zero stock q)).val)
    rw [eval_mapped_value, eval_mapped_value]
    exact h D
  · intro h C
    have hc := h (mapRefs (value T zero stock) C)
    change signature ((Context.eval (operationG T zero stock)
      (mapRefs (value T zero stock) C) (value T zero stock p)).val) =
        signature ((Context.eval (operationG T zero stock)
          (mapRefs (value T zero stock) C) (value T zero stock q)).val) at hc
    rw [eval_mapped_value, eval_mapped_value] at hc
    exact hc

/-- The existing compiler accounts for every reference occurrence exactly. -/
theorem compiled_budget (C : Context (Program S)) (p : Program S) :
    budget (realize C p) = budget p + referenceBudget C :=
  AllocatedPreparation.budget_realize C p

/-- Ambient response equivalence restricts to generated-reference contexts.
There is no converse here without a separate ambient completeness premise. -/
theorem ambient_responseEq_restrict (signature : V → Ω)
    {x y : G T zero stock}
    (h : ResponseEq T signature x.val y.val) :
    ResponseEq (operationG T zero stock) (signatureG T zero stock signature) x y := by
  intro C
  change signature ((Context.eval (operationG T zero stock) C x).val) =
    signature ((Context.eval (operationG T zero stock) C y).val)
  rw [eval_coe, eval_coe]
  exact h (mapRefs Subtype.val C)

end

end IDT.QMClosure.AllocatedGeneratedContexts
