import Proofs.QMClosure.NativeAllocatedSignatureLaw
import Proofs.QMClosure.NativeAllocatedStableObservation

/-!
# A nonseparating, nonconstant finite observation on allocated values

The Gaussian residue `i ↦ 3 (mod 5)` extends uniquely across every power-of-two
denominator. On the exact scalar carrier generated by finite explicitly
allocated 0/1 programs, its full contextual response equivalence is precisely
equality of residues. Thus a nonconstant supplied signature need not separate
generated values: zero and the explicitly generated value five remain
contextually indistinguishable.

The existing six-field single-basis response-law contract has no inhabitant
for this signature. Consequently it cannot preserve the probability field of
any supplied scalar law. This is a mathematical consistency obstruction on
the specified generated carrier and native contexts; it supplies no detector,
probability provenance, physical availability, actualization, or QM closure.
-/

namespace IDT.QMClosure.NativeAllocatedResidueObservation

noncomputable section

open OperationalContextQuotient ResponseContextQuotient
open NativeAllocatedObservationBoundary NativeAllocatedSourceArithmetic
open NativeAllocatedSignatureLaw
open NativeDyadicSixWireObstruction (rho Related)

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

private theorem cast_two_pow (k : ℕ) :
    ((2 ^ k : GaussianInt) : ℂ) = (2 : ℂ) ^ k := by
  rw [map_pow]
  have htwo : GaussianInt.toComplex (2 : GaussianInt) = (2 : ℂ) := by
    norm_num [GaussianInt.toComplex_def]
  rw [htwo]

/-- Reduction does not depend on the chosen Gaussian-dyadic presentation. -/
theorem related_unique {z : ℂ} {r s : ZMod 5}
    (hr : Related z r) (hs : Related z s) : r = s := by
  obtain ⟨k, u, hu, hru⟩ := hr
  obtain ⟨l, v, hv, hsv⟩ := hs
  have hcross : u * 2 ^ l = v * 2 ^ k := by
    apply GaussianInt.toComplex_inj.mp
    simp only [GaussianInt.toComplex_mul, cast_two_pow]
    exact (div_eq_div_iff
      (pow_ne_zero k (by norm_num : (2 : ℂ) ≠ 0))
      (pow_ne_zero l (by norm_num : (2 : ℂ) ≠ 0))).mp (hu.symm.trans hv)
  have hres := congrArg rho hcross
  simp only [map_mul, map_pow, map_ofNat, hru, hsv] at hres
  apply mul_right_cancel₀
    (mul_ne_zero (pow_ne_zero k (by decide : (2 : ZMod 5) ≠ 0))
      (pow_ne_zero l (by decide : (2 : ZMod 5) ≠ 0)))
  calc
    r * ((2 : ZMod 5) ^ k * 2 ^ l) = (r * 2 ^ k) * 2 ^ l := by ring
    _ = (s * 2 ^ l) * 2 ^ k := hres
    _ = s * (2 ^ k * 2 ^ l) := by ring

/-- Every Gaussian dyadic admits exactly one residue. -/
theorem gaussian_dyadic_existsUnique_related {z : ℂ} (hz : GaussianDyadic z) :
    ∃! r : ZMod 5, Related z r := by
  obtain ⟨k, u, hu⟩ := hz
  let r : ZMod 5 := rho u / (2 : ZMod 5) ^ k
  have hr : Related z r := by
    refine ⟨k, u, hu, ?_⟩
    exact (div_mul_cancel₀ (rho u) (pow_ne_zero k (by decide))).symm
  exact ⟨r, hr, fun _ hs => related_unique hs hr⟩

theorem generated_exists_related (x : NativeAllocatedObservationBoundary.G) :
    ∃ r : ZMod 5, Related x.val r := by
  have hx : Reachable x.val := (generated_iff_reachable x.val).mp x.property
  exact (gaussian_dyadic_existsUnique_related
    ((reachable_iff_gaussian_dyadic x.val).mp hx)).exists

/-- A supplied finite observation, defined on the actual generated carrier. -/
def residue (x : NativeAllocatedObservationBoundary.G) : ZMod 5 :=
  Classical.choose (generated_exists_related x)

theorem related_residue (x : NativeAllocatedObservationBoundary.G) :
    Related x.val (residue x) := Classical.choose_spec (generated_exists_related x)

theorem residue_eq_of_related {x : NativeAllocatedObservationBoundary.G} {r : ZMod 5}
    (hr : Related x.val r) : residue x = r := related_unique (related_residue x) hr

theorem related_iff_residue_eq (x : NativeAllocatedObservationBoundary.G) (r : ZMod 5) :
    Related x.val r ↔ residue x = r := by
  constructor
  · exact residue_eq_of_related
  · intro h
    rw [← h]
    exact related_residue x

/-- The two native outputs preserve exactly the residue gate. -/
theorem residue_operationG (x y : NativeAllocatedObservationBoundary.G) :
    residue (operationG (x, y)).1 = 2 * residue x + 4 * residue y ∧
      residue (operationG (x, y)).2 = 4 * residue x + 2 * residue y := by
  have h := NativeGaussianDyadicClosure.related_mixer (related_residue x) (related_residue y)
  exact ⟨residue_eq_of_related h.1, residue_eq_of_related h.2⟩

theorem responseEq_iff_residue_eq (x y : NativeAllocatedObservationBoundary.G) :
    ResponseEq operationG residue x y ↔ residue x = residue y := by
  constructor
  · exact signature_eq
  · intro h
    apply relation_le_responseEq operationG residue
      (fun u v => residue u = residue v) (fun _ _ h => h) ?_ ?_ h
    · intro s u v r huv
      cases s with
      | first =>
        change residue (operationG (u, r)).1 = residue (operationG (v, r)).1
        rw [(residue_operationG u r).1, (residue_operationG v r).1, huv]
      | second =>
        change residue (operationG (u, r)).2 = residue (operationG (v, r)).2
        rw [(residue_operationG u r).2, (residue_operationG v r).2, huv]
    · intro s u v r huv
      cases s with
      | first =>
        change residue (operationG (r, u)).1 = residue (operationG (r, v)).1
        rw [(residue_operationG r u).1, (residue_operationG r v).1, huv]
      | second =>
        change residue (operationG (r, u)).2 = residue (operationG (r, v)).2
        rw [(residue_operationG r u).2, (residue_operationG r v).2, huv]

@[simp] theorem residue_zeroG : residue zeroG = 0 :=
  residue_eq_of_related NativeGaussianDyadicClosure.related_zero

@[simp] theorem residue_unitG : residue unitG = 1 :=
  residue_eq_of_related NativeGaussianDyadicClosure.related_one

/-- Five is supplied by an explicitly allocated finite 0/1 program. -/
def fiveG : NativeAllocatedObservationBoundary.G := ofProgram (naturalProgram 5)

@[simp] theorem val_fiveG : fiveG.val = 5 := by
  exact value_naturalProgram 5

@[simp] theorem residue_fiveG : residue fiveG = 0 := by
  apply residue_eq_of_related
  refine ⟨0, 5, ?_, ?_⟩
  · rw [val_fiveG]
    norm_num [GaussianInt.toComplex_def]
  · decide

theorem zeroG_ne_fiveG : zeroG ≠ fiveG := by
  intro h
  have hv := congrArg Subtype.val h
  simp at hv

theorem residue_nonconstant : ∃ x y, residue x ≠ residue y := by
  exact ⟨zeroG, unitG, by simp⟩

theorem zeroG_responseEq_fiveG : ResponseEq operationG residue zeroG fiveG := by
  rw [responseEq_iff_residue_eq]
  simp

theorem residue_not_separates : ¬ Separates residue := by
  intro hsep
  exact zeroG_ne_fiveG (hsep zeroG fiveG zeroG_responseEq_fiveG)

theorem residue_not_injective : ¬ Function.Injective residue := by
  intro hinj
  exact zeroG_ne_fiveG (hinj (by simp))

/-- Every residue fiber is dense in the standard subtype topology on G. -/
theorem residue_dense_fiber (v : NativeAllocatedObservationBoundary.G) :
    Dense {w : NativeAllocatedObservationBoundary.G | residue w = residue v} :=
  NativeAllocatedStableObservation.dense_fiber_of_distinct_responseEq residue
    zeroG_ne_fiveG zeroG_responseEq_fiveG v

/-- No nonempty relatively open patch can carry a constant residue. -/
theorem residue_no_open_constant_patch :
    ¬ NativeAllocatedStableObservation.HasOpenConstantPatch residue := by
  intro hpatch
  exact residue_not_separates
    ((NativeAllocatedStableObservation.separates_iff_nonconstant_of_open_constant_patch
      residue hpatch).mpr residue_nonconstant)

/-- The unchanged six-field contract rules out this supplied observation. -/
theorem residue_no_law :
    ¬ Nonempty (ResponseNativeProbabilitySelection.Law (signatureData residue) unitG) := by
  intro h
  exact residue_not_separates ((law_nonempty_iff_separates residue).mp h)

/-- In particular no complete supplied probability field can be transported. -/
theorem residue_no_same_probability_law (L : NativeVacuumProbabilityFamily.Law) :
    ¬ (∃ M : ResponseNativeProbabilitySelection.Law (signatureData residue) unitG,
      @ResponseNativeProbabilitySelection.Law.prob
          NativeAllocatedObservationBoundary.G (ZMod 5) (signatureData residue) unitG M =
        @NativeVacuumProbabilityFamily.Law.prob L) := by
  rintro ⟨M, _⟩
  exact residue_no_law ⟨M⟩

end
end IDT.QMClosure.NativeAllocatedResidueObservation
