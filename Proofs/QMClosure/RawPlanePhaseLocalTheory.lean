import Proofs.QMClosure.RawPlanePhaseSparseWall

/-!
# Two-preparation quantifier-free laws in the continuous sparse countermodel

Terms use two preparation variables, zero, mixing and complex scalar
coefficients. Formulas compare terms or apply one fixed predicate to a finite
list of real readouts, and are closed under conjunction and negation.

Transport inside the actual input plane preserves every formula in this exact
language. Consequently the continuous sparse countermodel satisfies every
collection of native-valid formulas in the language. There are no arbitrary
preparation constants, preparation quantifiers, environment-dependent
predicates, or topology predicates in this syntax.
-/

namespace IDT.QMClosure.RawPlanePhaseLocalTheory

noncomputable section

open RawPlanePhaseFamily RawPlanePhaseGeometry RawPlanePhaseControl

/-- The coefficients are supplied complex scalars, and the only preparation
variables are the two elements of `Fin 2`. -/
inductive Term2 where
  | var (i : Fin 2)
  | zero
  | mix (left right : Term2)
  | smul (coefficient : ℂ) (term : Term2)

def evalNative : Term2 → Vec → Vec → Vec
  | .var i, x, y => ![x, y] i
  | .zero, _, _ => 0
  | .mix left right, x, y => native (evalNative left x y) (evalNative right x y)
  | .smul c term, x, y => c • evalNative term x y

def evalActual : Term2 → Vec → Vec → Vec
  | .var i, x, y => ![x, y] i
  | .zero, _, _ => 0
  | .mix left right, x, y => m (evalActual left x y) (evalActual right x y)
  | .smul c term, x, y => c • evalActual term x y

/-- Every actual term stays in the ordinary complex span of its two inputs. -/
theorem evalActual_inPlane (term : Term2) (x y : Vec) :
    InPlane x y (evalActual term x y) := by
  induction term with
  | var i =>
      fin_cases i
      · exact inPlane_left x y
      · exact inPlane_right x y
  | zero => exact inPlane_zero x y
  | mix left right ihLeft ihRight => exact inPlane_m ihLeft ihRight
  | smul c term ih => exact inPlane_smul c ih

/-- One fixed phase transport intertwines every term generated by the actual
input pair with its native interpretation in the transported input pair. -/
theorem evalActual_transport (term : Term2) (x y : Vec) :
    evalActual term x y =
      H (parameter x y)
        (evalNative term (H (-(parameter x y)) x) (H (-(parameter x y)) y)) := by
  induction term with
  | var i =>
      fin_cases i <;> simp [evalActual, evalNative]
  | zero => simp [evalActual, evalNative]
  | mix left right ihLeft ihRight =>
      change m (evalActual left x y) (evalActual right x y) =
        H (parameter x y)
          (native
            (evalNative left (H (-(parameter x y)) x) (H (-(parameter x y)) y))
            (evalNative right (H (-(parameter x y)) x) (H (-(parameter x y)) y)))
      rw [m_eq_family_of_inPlane (evalActual_inPlane left x y)
        (evalActual_inPlane right x y), ihLeft, ihRight, familyM_H]
  | smul c term ih =>
      simpa only [evalActual, evalNative, H_smul] using congrArg (c • ·) ih

def readoutsNative (terms : List Term2) (x y : Vec) : List ℝ :=
  terms.map (fun term => W (evalNative term x y))

def readoutsActual (terms : List Term2) (x y : Vec) : List ℝ :=
  terms.map (fun term => W (evalActual term x y))

theorem readoutsActual_transport (terms : List Term2) (x y : Vec) :
    readoutsActual terms x y =
      readoutsNative terms (H (-(parameter x y)) x) (H (-(parameter x y)) y) := by
  induction terms with
  | nil => rfl
  | cons term terms ih =>
      change W (evalActual term x y) :: readoutsActual terms x y =
        W (evalNative term (H (-(parameter x y)) x) (H (-(parameter x y)) y)) ::
          readoutsNative terms (H (-(parameter x y)) x) (H (-(parameter x y)) y)
      rw [evalActual_transport, W_H, ih]

/-- The predicate receives only the displayed finite real readout list. The
same predicate is used in both semantics, with no environment argument. -/
inductive QuantifierfreeFormula2 where
  | termEq (left right : Term2)
  | readoutPredicate (predicate : List ℝ → Prop) (terms : List Term2)
  | conj (left right : QuantifierfreeFormula2)
  | neg (formula : QuantifierfreeFormula2)

def holdsNative : QuantifierfreeFormula2 → Vec → Vec → Prop
  | .termEq left right, x, y => evalNative left x y = evalNative right x y
  | .readoutPredicate predicate terms, x, y => predicate (readoutsNative terms x y)
  | .conj left right, x, y => holdsNative left x y ∧ holdsNative right x y
  | .neg formula, x, y => ¬ holdsNative formula x y

def holdsActual : QuantifierfreeFormula2 → Vec → Vec → Prop
  | .termEq left right, x, y => evalActual left x y = evalActual right x y
  | .readoutPredicate predicate terms, x, y => predicate (readoutsActual terms x y)
  | .conj left right, x, y => holdsActual left x y ∧ holdsActual right x y
  | .neg formula, x, y => ¬ holdsActual formula x y

/-- No regularity or decidability assumption is imposed on the fixed readout
predicates. Injectivity and readout preservation suffice for truth transfer. -/
theorem holdsActual_iff_transported (formula : QuantifierfreeFormula2) (x y : Vec) :
    holdsActual formula x y ↔
      holdsNative formula (H (-(parameter x y)) x) (H (-(parameter x y)) y) := by
  induction formula with
  | termEq left right =>
      change evalActual left x y = evalActual right x y ↔ _
      rw [evalActual_transport, evalActual_transport]
      exact (H_injective (parameter x y)).eq_iff
  | readoutPredicate predicate terms =>
      change predicate (readoutsActual terms x y) ↔ _
      rw [readoutsActual_transport]
      rfl
  | conj left right ihLeft ihRight =>
      exact and_congr ihLeft ihRight
  | neg formula ih => exact not_congr ih

def nativeValid (formula : QuantifierfreeFormula2) : Prop :=
  ∀ x y : Vec, holdsNative formula x y

def actualValid (formula : QuantifierfreeFormula2) : Prop :=
  ∀ x y : Vec, holdsActual formula x y

theorem nativeValid_implies_actualValid (formula : QuantifierfreeFormula2)
    (h : nativeValid formula) : actualValid formula := by
  intro x y
  exact (holdsActual_iff_transported formula x y).mpr (h _ _)

/-- All listed properties belong to the same supplied actual operation. -/
def ActualCountermodelProperties : Prop :=
  RawSparseConservationTests.Tests contract ∧
  (∀ x y, RawSparseConservationTests.SparseAt contract x y
    (RawSparseConservationSelection.A contract x)) ∧
  (∀ x, 0 ≤ contract.weight x) ∧
  (∀ x, contract.weight x = 0 ↔ x = contract.chosenZero) ∧
  RawSparseConservationSelection.PairConserved contract ∧
  (∀ (c : ℂ) (x y : Vec), m (c • x) (c • y) = c • m x y) ∧
  Continuous operation ∧
  ¬ RawSparseConservationSelection.SparseMarginalLaw contract ∧
  ¬ RawSparseConservationSelection.ObservedMedial contract

theorem actualCountermodelProperties : ActualCountermodelProperties :=
  RawPlanePhaseSparseWall.constructed_continuous_countermodel

/-- Every collection of native-valid laws in this exact language holds in one
globally continuous faithful model that fails the full sparse marginal law.
Scalar-parameter families are included by ranging over their formula instances. -/
theorem native_valid_collection_countermodel (Γ : Set QuantifierfreeFormula2)
    (hΓ : ∀ formula ∈ Γ, nativeValid formula) :
    (∀ formula ∈ Γ, actualValid formula) ∧ ActualCountermodelProperties := by
  refine ⟨?_, actualCountermodelProperties⟩
  intro formula hformula
  exact nativeValid_implies_actualValid formula (hΓ formula hformula)

/-- In the supplied actual model, no such collection implies the failed full
sparse law. The statement concerns only the syntax and semantics above. -/
theorem native_valid_collection_does_not_force_sparse (Γ : Set QuantifierfreeFormula2)
    (hΓ : ∀ formula ∈ Γ, nativeValid formula) :
    ¬ ((∀ formula ∈ Γ, actualValid formula) →
      RawSparseConservationSelection.SparseMarginalLaw contract) := by
  intro hforce
  exact RawPlanePhaseSparseWall.constructed_not_sparse
    (hforce (native_valid_collection_countermodel Γ hΓ).1)

end
end IDT.QMClosure.RawPlanePhaseLocalTheory
