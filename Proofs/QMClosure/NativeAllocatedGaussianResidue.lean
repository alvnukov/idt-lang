import Proofs.QMClosure.NativeAllocatedObservationBoundary
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Finset.Lattice.Fold

/-!
# Full Gaussian residues on the allocated scalar carrier

Both Gaussian coordinates are retained modulo an arbitrary odd modulus.
Multiplication below is Gaussian multiplication, explicitly supplied on pairs;
it is not the coordinatewise product-ring multiplication. Powers of two are
cancelled only as units. No prime-modulus or field assumption is used.

Every finite set of generated Gaussian dyadics admits an injective such residue
map. All scalar values and references remain generated by the original finite
allocated programs. This exact arithmetic observation supplies no detector,
probability provenance, physical availability, actualization, or QM closure.
-/

namespace IDT.QMClosure.NativeAllocatedGaussianResidue

noncomputable section
set_option maxRecDepth 16384
set_option maxHeartbeats 4000000

open OperationalContextQuotient ResponseContextQuotient
open NativeAllocatedObservationBoundary NativeAllocatedSourceArithmetic
open NativeAttenuationCircuit (a b)

abbrev Residue (M : ℕ) := ZMod M × ZMod M

def addR {M : ℕ} (r s : Residue M) : Residue M := (r.1 + s.1, r.2 + s.2)
def mulR {M : ℕ} (r s : Residue M) : Residue M :=
  (r.1 * s.1 - r.2 * s.2, r.1 * s.2 + r.2 * s.1)
def scaleR {M : ℕ} (t : ZMod M) (r : Residue M) : Residue M := (r.1 * t, r.2 * t)
def gaussianResidue (M : ℕ) (g : GaussianInt) : Residue M := (g.re, g.im)

theorem gaussianResidue_add (M : ℕ) (u v : GaussianInt) :
    gaussianResidue M (u + v) = addR (gaussianResidue M u) (gaussianResidue M v) := by
  ext <;> simp [gaussianResidue, addR, Zsqrtd.re_add, Zsqrtd.im_add]

theorem gaussianResidue_mul (M : ℕ) (u v : GaussianInt) :
    gaussianResidue M (u * v) = mulR (gaussianResidue M u) (gaussianResidue M v) := by
  ext <;> simp [gaussianResidue, mulR, Zsqrtd.re_mul, Zsqrtd.im_mul]
  ring

private theorem gaussianResidue_two_pow (M k : ℕ) :
    gaussianResidue M (2 ^ k) = ((2 : ZMod M)^k, 0) := by
  induction k with
  | zero => simp [gaussianResidue]
  | succ k ih =>
    rw [pow_succ, gaussianResidue_mul, ih]
    simp [mulR, gaussianResidue, pow_succ]

private theorem gaussianResidue_mul_two_pow (M : ℕ) (u : GaussianInt) (k : ℕ) :
    gaussianResidue M (u * 2 ^ k) = scaleR ((2 : ZMod M)^k) (gaussianResidue M u) := by
  rw [gaussianResidue_mul, gaussianResidue_two_pow]
  ext <;> simp [mulR, scaleR]

private theorem cast_two_pow (k : ℕ) :
    ((2 ^ k : GaussianInt) : ℂ) = (2 : ℂ)^k := by
  rw [map_pow]
  have htwo : GaussianInt.toComplex (2 : GaussianInt) = (2 : ℂ) := by
    norm_num [GaussianInt.toComplex_def]
  rw [htwo]

theorem two_isUnit (M : ℕ) (hM : Odd M) : IsUnit (2 : ZMod M) := by
  apply ZMod.isUnit_prime_of_not_dvd Nat.prime_two
  intro hd
  have hm := Nat.mod_eq_zero_of_dvd hd
  rw [Nat.odd_iff] at hM
  omega

private theorem cancel_two_pow (M : ℕ) (hM : Odd M) (k : ℕ)
    {r s : ZMod M} (h : r * 2^k = s * 2^k) : r = s := by
  have hu : IsUnit ((2 : ZMod M)^k) := (two_isUnit M hM).pow k
  have hp := ZMod.mul_inv_of_unit ((2 : ZMod M)^k) hu
  have he := congrArg (fun t : ZMod M => t * ((2 : ZMod M)^k)⁻¹) h
  simpa only [mul_assoc, hp, mul_one] using he

private theorem scale_inverse (M : ℕ) (hM : Odd M) (k : ℕ) (r : Residue M) :
    scaleR ((2 : ZMod M)^k) (scaleR (((2 : ZMod M)^k)⁻¹) r) = r := by
  have hu : IsUnit ((2 : ZMod M)^k) := (two_isUnit M hM).pow k
  have hp := ZMod.inv_mul_of_unit ((2 : ZMod M)^k) hu
  ext <;> simp only [scaleR, mul_assoc, hp, mul_one]

/-- A complex Gaussian dyadic and its full two-coordinate residue certificate. -/
def Related (M : ℕ) (z : ℂ) (r : Residue M) : Prop :=
  ∃ k : ℕ, ∃ g : GaussianInt, z = (g : ℂ) / (2 : ℂ)^k ∧
    gaussianResidue M g = scaleR ((2 : ZMod M)^k) r

theorem related_unique (M : ℕ) (hM : Odd M) {z : ℂ} {r s : Residue M}
    (hr : Related M z r) (hs : Related M z s) : r = s := by
  obtain ⟨k, u, hu, hru⟩ := hr
  obtain ⟨l, v, hv, hsv⟩ := hs
  have hcross : u * 2 ^ l = v * 2 ^ k := by
    apply GaussianInt.toComplex_inj.mp
    simp only [GaussianInt.toComplex_mul, cast_two_pow]
    exact (div_eq_div_iff
      (pow_ne_zero k (by norm_num : (2 : ℂ) ≠ 0))
      (pow_ne_zero l (by norm_num : (2 : ℂ) ≠ 0))).mp (hu.symm.trans hv)
  have hm := congrArg (gaussianResidue M) hcross
  rw [gaussianResidue_mul_two_pow, gaussianResidue_mul_two_pow, hru, hsv] at hm
  apply Prod.ext
  · apply cancel_two_pow M hM (k + l)
    have he := congrArg Prod.fst hm
    simpa only [scaleR, pow_add, mul_assoc, mul_comm, mul_left_comm] using he
  · apply cancel_two_pow M hM (k + l)
    have he := congrArg Prod.snd hm
    simpa only [scaleR, pow_add, mul_assoc, mul_comm, mul_left_comm] using he

theorem related_of_presentation (M : ℕ) (hM : Odd M) {z : ℂ} (k : ℕ)
    (g : GaussianInt) (hg : z = (g : ℂ) / (2 : ℂ)^k) :
    Related M z (scaleR (((2 : ZMod M)^k)⁻¹) (gaussianResidue M g)) :=
  ⟨k, g, hg, (scale_inverse M hM k (gaussianResidue M g)).symm⟩

theorem generated_exists_related (M : ℕ) (hM : Odd M) (x : G) :
    ∃ r : Residue M, Related M x.val r := by
  have hx : Reachable x.val := (generated_iff_reachable x.val).mp x.property
  obtain ⟨k, g, hg⟩ := (reachable_iff_gaussian_dyadic x.val).mp hx
  exact ⟨_, related_of_presentation M hM k g hg⟩

def residue (M : ℕ) (hM : Odd M) (x : G) : Residue M :=
  Classical.choose (generated_exists_related M hM x)

theorem related_residue (M : ℕ) (hM : Odd M) (x : G) :
    Related M x.val (residue M hM x) :=
  Classical.choose_spec (generated_exists_related M hM x)

theorem residue_eq_of_related (M : ℕ) (hM : Odd M) {x : G} {r : Residue M}
    (hr : Related M x.val r) : residue M hM x = r :=
  related_unique M hM (related_residue M hM x) hr

theorem residue_presentation (M : ℕ) (hM : Odd M) (x : G) (k : ℕ)
    (g : GaussianInt) (hg : x.val = (g : ℂ) / (2 : ℂ)^k) :
    gaussianResidue M g = scaleR ((2 : ZMod M)^k) (residue M hM x) := by
  rw [residue_eq_of_related M hM (related_of_presentation M hM k g hg)]
  exact (scale_inverse M hM k (gaussianResidue M g)).symm

theorem related_add (M : ℕ) {z w : ℂ} {r s : Residue M}
    (hz : Related M z r) (hw : Related M w s) : Related M (z + w) (addR r s) := by
  obtain ⟨k, u, hu, hr⟩ := hz
  obtain ⟨l, v, hv, hs⟩ := hw
  refine ⟨k + l, u * 2 ^ l + v * 2 ^ k, ?_, ?_⟩
  · rw [GaussianInt.toComplex_add, GaussianInt.toComplex_mul,
      GaussianInt.toComplex_mul, cast_two_pow, cast_two_pow, hu, hv, pow_add]
    field_simp
  · rw [gaussianResidue_add, gaussianResidue_mul_two_pow, gaussianResidue_mul_two_pow, hr, hs]
    ext <;> simp [addR, scaleR, pow_add] <;> ring

theorem related_mul (M : ℕ) {z w : ℂ} {r s : Residue M}
    (hz : Related M z r) (hw : Related M w s) : Related M (z * w) (mulR r s) := by
  obtain ⟨k, u, hu, hr⟩ := hz
  obtain ⟨l, v, hv, hs⟩ := hw
  refine ⟨k + l, u * v, ?_, ?_⟩
  · rw [GaussianInt.toComplex_mul, hu, hv, pow_add]
    field_simp
  · rw [gaussianResidue_mul, hr, hs]
    ext <;> simp [mulR, scaleR, pow_add] <;> ring

def aR (M : ℕ) : Residue M := ((2 : ZMod M)⁻¹, (2 : ZMod M)⁻¹)
def bR (M : ℕ) : Residue M := ((2 : ZMod M)⁻¹, -(2 : ZMod M)⁻¹)

private theorem related_a (M : ℕ) (hM : Odd M) : Related M a (aR M) := by
  refine ⟨1, ⟨1, 1⟩, ?_, ?_⟩
  · norm_num [a, GaussianInt.toComplex_def']
  · have hp := ZMod.inv_mul_of_unit (2 : ZMod M) (two_isUnit M hM)
    ext <;> simp [gaussianResidue, scaleR, aR, hp]

private theorem related_b (M : ℕ) (hM : Odd M) : Related M b (bR M) := by
  refine ⟨1, ⟨1, -1⟩, ?_, ?_⟩
  · norm_num [b, GaussianInt.toComplex_def', sub_eq_add_neg]
  · have hp := ZMod.inv_mul_of_unit (2 : ZMod M) (two_isUnit M hM)
    ext <;> simp [gaussianResidue, scaleR, bR, hp, neg_mul]

def residueOperation (M : ℕ) (p : Residue M × Residue M) : Residue M × Residue M :=
  (addR (mulR (aR M) p.1) (mulR (bR M) p.2),
   addR (mulR (bR M) p.1) (mulR (aR M) p.2))

theorem residue_operationG (M : ℕ) (hM : Odd M) (x y : G) :
    (residue M hM (operationG (x, y)).1, residue M hM (operationG (x, y)).2) =
      residueOperation M (residue M hM x, residue M hM y) := by
  apply Prod.ext
  · apply residue_eq_of_related M hM
    change Related M (NativeMixerEventConeExclusion.mixer (x.val, y.val)).1 _
    rw [NativeAttenuationCircuit.mixer_fst]
    exact related_add M (related_mul M (related_a M hM) (related_residue M hM x))
      (related_mul M (related_b M hM) (related_residue M hM y))
  · apply residue_eq_of_related M hM
    change Related M (NativeMixerEventConeExclusion.mixer (x.val, y.val)).2 _
    rw [NativeAttenuationCircuit.mixer_snd]
    exact related_add M (related_mul M (related_b M hM) (related_residue M hM x))
      (related_mul M (related_a M hM) (related_residue M hM y))

theorem responseEq_of_residue_eq {Ω : Type*} (M : ℕ) (hM : Odd M)
    (χ : Residue M → Ω) {x y : G} (h : residue M hM x = residue M hM y) :
    ResponseEq operationG (fun z => χ (residue M hM z)) x y := by
  apply relation_le_responseEq operationG (fun z => χ (residue M hM z))
    (fun u v => residue M hM u = residue M hM v) (fun _ _ he => congrArg χ he) ?_ ?_ h
  · intro o u v r huv
    have he : residueOperation M (residue M hM u, residue M hM r) =
        residueOperation M (residue M hM v, residue M hM r) := by rw [huv]
    rw [← residue_operationG M hM, ← residue_operationG M hM] at he
    cases o with
    | first => exact congrArg Prod.fst he
    | second => exact congrArg Prod.snd he
  · intro o u v r huv
    have he : residueOperation M (residue M hM r, residue M hM u) =
        residueOperation M (residue M hM r, residue M hM v) := by rw [huv]
    rw [← residue_operationG M hM, ← residue_operationG M hM] at he
    cases o with
    | first => exact congrArg Prod.fst he
    | second => exact congrArg Prod.snd he

def naturalG (n : ℕ) : G := ofProgram (naturalProgram n)

@[simp] theorem val_naturalG (n : ℕ) : (naturalG n).val = n := value_naturalProgram n

theorem naturalG_injective : Function.Injective naturalG := by
  intro n m h
  have hv := congrArg Subtype.val h
  simp only [val_naturalG] at hv
  exact_mod_cast hv

@[simp] theorem residue_zeroG (M : ℕ) (hM : Odd M) : residue M hM zeroG = (0, 0) := by
  apply residue_eq_of_related M hM
  exact ⟨0, 0, by simp, by simp [gaussianResidue, scaleR]⟩

theorem residue_natural_modulus (M : ℕ) (hM : Odd M) :
    residue M hM (naturalG M) = (0, 0) := by
  apply residue_eq_of_related M hM
  refine ⟨0, M, ?_, ?_⟩
  · simp
  · ext <;> simp [gaussianResidue, scaleR]

private theorem raise_denominator {z : ℂ} {k : ℕ} {g : GaussianInt}
    (h : z = (g : ℂ) / (2 : ℂ)^k) (l : ℕ) :
    z = ((g * 2^l : GaussianInt) : ℂ) / (2 : ℂ)^(k + l) := by
  rw [GaussianInt.toComplex_mul, cast_two_pow, pow_add, h]
  field_simp

theorem common_denominator (S : Finset G) :
    ∃ h : ℕ, ∃ g : G → GaussianInt, ∀ x ∈ S, x.val = (g x : ℂ) / (2 : ℂ)^h := by
  classical
  induction S using Finset.induction_on with
  | empty => exact ⟨0, fun _ => 0, by simp⟩
  | @insert x S hx ih =>
    obtain ⟨h, g, hg⟩ := ih
    have hreach : Reachable x.val := (generated_iff_reachable x.val).mp x.property
    obtain ⟨k, u, hu⟩ := (reachable_iff_gaussian_dyadic x.val).mp hreach
    refine ⟨h + k, fun y => if y = x then u * 2^h else g y * 2^k, ?_⟩
    intro y hy
    by_cases he : y = x
    · subst y
      simpa only [if_pos rfl, Nat.add_comm h k] using raise_denominator hu h
    · simp only [if_neg he]
      exact raise_denominator (hg y ((Finset.mem_insert.mp hy).resolve_left he)) k

/-- The modulus is odd and may be composite. Injectivity is only on the
supplied finite set, independently of its labels. -/
theorem exists_finite_injective_residue (S : Finset G) :
    ∃ M : ℕ, ∃ hM : Odd M, 1 < M ∧ Set.InjOn (residue M hM) (S : Set G) := by
  classical
  obtain ⟨h, g, hg⟩ := common_denominator S
  let B := S.sup (fun x => S.sup (fun y =>
    max (((g y).re - (g x).re).natAbs) (((g y).im - (g x).im).natAbs)))
  let M := 2 * B + 3
  have hM : Odd M := ⟨B + 1, by dsimp [M]; omega⟩
  refine ⟨M, hM, by dsimp [M]; omega, ?_⟩
  intro x hx y hy he
  have hpair : gaussianResidue M (g x) = gaussianResidue M (g y) := by
    rw [residue_presentation M hM x h (g x) (hg x hx),
      residue_presentation M hM y h (g y) (hg y hy), he]
  have hbound : max (((g y).re - (g x).re).natAbs)
      (((g y).im - (g x).im).natAbs) ≤ B := by
    dsimp only [B]
    apply Finset.le_sup_of_le (show x ∈ S from hx)
    exact Finset.le_sup (f := fun yy =>
      max (((g yy).re - (g x).re).natAbs) (((g yy).im - (g x).im).natAbs)) hy
  have hre : (M : ℤ) ∣ (g y).re - (g x).re :=
    (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ M).mp (congrArg Prod.fst hpair)
  have him : (M : ℤ) ∣ (g y).im - (g x).im :=
    (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ M).mp (congrArg Prod.snd hpair)
  have hre0 : (g y).re - (g x).re = 0 := by
    apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hre
    have hb := (le_max_left _ _).trans hbound
    simpa only [Int.natAbs_natCast] using (show ((g y).re - (g x).re).natAbs < M by
      dsimp [M]; omega)
  have him0 : (g y).im - (g x).im = 0 := by
    apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs him
    have hb := (le_max_right _ _).trans hbound
    simpa only [Int.natAbs_natCast] using (show ((g y).im - (g x).im).natAbs < M by
      dsimp [M]; omega)
  have hnum : g x = g y := by
    apply Zsqrtd.ext
    · exact (sub_eq_zero.mp hre0).symm
    · exact (sub_eq_zero.mp him0).symm
  apply Subtype.ext
  rw [hg x hx, hg y hy, hnum]

end
end IDT.QMClosure.NativeAllocatedGaussianResidue
