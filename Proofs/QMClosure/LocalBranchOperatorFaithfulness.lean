import Proofs.QMClosure.SingleCalibrationScalarFaithfulness
import Proofs.QMClosure.FiniteScalarReversalBoundary
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Data.Fintype.Pigeonhole
import Mathlib.Tactic

/-!
# Local branch response and faithful operator arithmetic

The input carrier is an additive commutative monoid. The only supplied
operation is one additive two-port map, transparent on the diagonal and with
square equal to port exchange. A real response is supplied only on branch
words. It is multiplicative under concatenation, has one normalized native
column, and descends through equality of the actual word endomorphisms.

The additive group and the commutative generated operator ring are conclusions.
The response is never evaluated on a sum of endomorphisms. Characteristic zero
uses only serial powers of the derived half. Faithfulness and conjugation refer
to the ring generated by the two native operators. Ambient endomorphisms need
not commute, and evaluation at an arbitrary carrier state need not be faithful.

A separate source contract strengthens extensionality to equality at one
supplied reference and derives reference-specific faithfulness. No scalar
arithmetic, nonzero reference, torsion-freeness, quadratic detector, Born rule,
full preparation space, Hilbert representation, or full QM claim is supplied
or inferred silently. Complex arithmetic appears only in consistency controls.

The prior `RawNativeProbabilityExistence.gaussianAction_injective_iff_referenceInfiniteOrder`
already characterizes source Gaussian faithfulness by reference infinite order.
The present premise reduction derives infinite order from a stationary calibrated
serial branch response alone. It does not claim the first Gaussian source-faithfulness
argument, and does not add a raw-medial adapter to remove the supplied additive monoid.
-/

namespace IDT.QMClosure.LocalBranchOperatorFaithfulness

noncomputable section

open SingleCalibrationScalarFaithfulness

abbrev Word := List Bool

/-- The complete operation and its two exact operational laws. -/
structure Gate (V : Type*) [AddCommMonoid V] where
  operation : (V × V) →+ (V × V)
  transparent : ∀ x, operation (x, x) = (x, x)
  square : ∀ p, operation (operation p) = p.swap

namespace Gate

variable {V : Type*} [AddCommMonoid V] (G : Gate V)

/-- The original addition and zero are preserved by this derived group. -/
abbrev additiveGroup : AddCommGroup V :=
  let r := (TransparentSwapRoot.reconstruct_operation G.operation
    G.transparent G.square).1
  OperationalQuadraticReconstruction.groupFromAntipodes
    (TransparentSwapRoot.phase (TransparentSwapRoot.portA G.operation)) r.cancellation

/-- A type synonym makes the group available without adding an input
instance. Its values, original addition, and zero are definitionally those of V. -/
def Carrier (_G : Gate V) := V

instance carrierGroup : AddCommGroup G.Carrier := G.additiveGroup

abbrev A : AddMonoid.End G.Carrier := TransparentSwapRoot.portA G.operation
abbrev B : AddMonoid.End G.Carrier := TransparentSwapRoot.portB G.operation
abbrev H : AddMonoid.End G.Carrier := G.A * G.B
abbrev U : AddMonoid.End G.Carrier := G.A * G.A + G.A * G.A

def reconstruction : TransparentSwapRoot.Reconstruction G.A G.B :=
  (TransparentSwapRoot.reconstruct_operation G.operation G.transparent G.square).1

def branch : Bool → AddMonoid.End G.Carrier
  | true => G.A
  | false => G.B

/-- Word multiplication acts by serial composition in the given carrier. -/
def evalWord : Word → AddMonoid.End G.Carrier
  | [] => 1
  | c :: w => G.branch c * evalWord w

@[simp] theorem evalWord_nil : G.evalWord [] = 1 := rfl

@[simp] theorem evalWord_cons (c : Bool) (w : Word) :
    G.evalWord (c :: w) = G.branch c * G.evalWord w := rfl

@[simp] theorem evalWord_singleton (c : Bool) :
    G.evalWord [c] = G.branch c := by simp [evalWord]

theorem evalWord_append (x y : Word) :
    G.evalWord (x ++ y) = G.evalWord x * G.evalWord y := by
  induction x with
  | nil => simp
  | cons c x ih => simp only [List.cons_append, evalWord_cons, ih, mul_assoc]

end Gate

/-- This is response on the generated action monoid, presented by words.
Extensionality is essential: a response on formal histories alone is weaker. -/
structure OperatorResponse {V : Type*} [AddCommMonoid V] (G : Gate V) where
  weight : Word → ℝ
  multiplicative : ∀ x y, weight (x ++ y) = weight x * weight y
  extensional : ∀ {x y}, G.evalWord x = G.evalWord y → weight x = weight y
  column : weight [true] + weight [false] = 1

/-- Repetition of a whole branch word, including the empty repetition. -/
def repeatWord (w : Word) : ℕ → Word
  | 0 => []
  | n + 1 => w ++ repeatWord w n

@[simp] theorem repeatWord_length (w : Word) (n : ℕ) :
    (repeatWord w n).length = w.length * n := by
  induction n with
  | zero => simp [repeatWord]
  | succ n ih => simp [repeatWord, ih, Nat.mul_succ, Nat.add_comm]

theorem evalWord_repeat {V : Type*} [AddCommMonoid V] (G : Gate V)
    (w : Word) (n : ℕ) : G.evalWord (repeatWord w n) = G.evalWord w ^ n := by
  induction n with
  | zero => simp [repeatWord]
  | succ n ih => rw [repeatWord, G.evalWord_append, ih, pow_succ']

namespace Gate

variable {V : Type*} [AddCommMonoid V] (G : Gate V)


theorem transparent_coefficients : G.A + G.B = 1 := by
  apply AddMonoidHom.ext
  intro x
  have hm := TransparentSwapRoot.operation_eq_symmetric_mixer G.operation G.square
  have hx := congrArg Prod.fst (G.transparent x)
  rw [congrFun hm] at hx
  exact hx

theorem same_coefficients : G.A * G.A + G.B * G.B = 0 :=
  AddMonoidHom.ext G.reconstruction.same

theorem commute_coefficients : G.A * G.B = G.B * G.A :=
  AddMonoidHom.ext G.reconstruction.commute

theorem double_half : (2 : AddMonoid.End G.Carrier) * G.H = 1 := by
  rw [two_mul]
  exact AddMonoidHom.ext G.reconstruction.halves

theorem phase_square : G.U ^ 2 = -(1 : AddMonoid.End G.Carrier) := by
  apply eq_neg_of_add_eq_zero_left
  apply AddMonoidHom.ext
  intro x
  change G.U (G.U x) + x = 0
  simpa only [add_comm] using G.reconstruction.cancellation x

theorem coefficient_a : G.A = G.H * (1 + G.U) :=
  AddMonoidHom.ext G.reconstruction.coefficientA

theorem fourth_coefficients_equal : G.A ^ 4 = G.B ^ 4 := by
  have hs : G.A * G.A = -(G.B * G.B) :=
    eq_neg_of_add_eq_zero_left G.same_coefficients
  calc
    G.A ^ 4 = (G.A * G.A) ^ 2 := by noncomm_ring
    _ = (G.B * G.B) ^ 2 := by rw [hs]; noncomm_ring
    _ = G.B ^ 4 := by noncomm_ring

/-- The ring is restricted to native generated operators. -/
abbrev generated : Subring (AddMonoid.End G.Carrier) := Subring.closure {G.A, G.B}

/-- Commutativity is derived only inside this generated ring. -/
abbrev generatedCommRing : CommRing G.generated :=
  Subring.closureCommRingOfComm (by
    intro x hx y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
    · rfl
    · exact G.commute_coefficients
    · exact G.commute_coefficients.symm
    · rfl)

abbrev generatedA : G.generated :=
  ⟨G.A, Subring.subset_closure (by simp)⟩

abbrev generatedB : G.generated :=
  ⟨G.B, Subring.subset_closure (by simp)⟩

abbrev generatedH : G.generated := G.generatedA * G.generatedB
abbrev generatedU : G.generated :=
  G.generatedA * G.generatedA + G.generatedA * G.generatedA

theorem evalWord_mem_generated (w : Word) : G.evalWord w ∈ G.generated := by
  induction w with
  | nil => exact G.generated.one_mem
  | cons c w ih =>
    apply G.generated.mul_mem _ ih
    cases c
    · exact G.generatedB.property
    · exact G.generatedA.property

/-- The serial word regarded as an element of the native generated algebra. -/
def generatedWord (w : Word) : G.generated :=
  ⟨G.evalWord w, G.evalWord_mem_generated w⟩

end Gate

namespace OperatorResponse

variable {V : Type*} [AddCommMonoid V] {G : Gate V} (C : OperatorResponse G)

include C

theorem weight_one : C.weight [] = 1 := by
  have ha : C.weight [true] = C.weight [] * C.weight [true] := by
    simpa using C.multiplicative [] [true]
  have hb : C.weight [false] = C.weight [] * C.weight [false] := by
    simpa using C.multiplicative [] [false]
  calc
    C.weight [] = C.weight [] * (C.weight [true] + C.weight [false]) := by
      rw [C.column, mul_one]
    _ = C.weight [true] + C.weight [false] := by rw [mul_add, ← ha, ← hb]
    _ = 1 := C.column

theorem weight_repeat (w : Word) (n : ℕ) :
    C.weight (repeatWord w n) = C.weight w ^ n := by
  induction n with
  | zero => simpa [repeatWord] using C.weight_one
  | succ n ih => rw [repeatWord, C.multiplicative, ih, pow_succ']

/-- No sign condition on the response is assumed. The real fourth-power
identity and one normalized column fix both native values. -/
theorem native_weights : C.weight [true] = 1 / 2 ∧ C.weight [false] = 1 / 2 := by
  have he : G.evalWord (repeatWord [true] 4) =
      G.evalWord (repeatWord [false] 4) := by
    rw [evalWord_repeat, evalWord_repeat]
    simpa only [Gate.evalWord_singleton, Gate.branch] using G.fourth_coefficients_equal
  have hf := C.extensional he
  rw [C.weight_repeat, C.weight_repeat] at hf
  have hs : C.weight [true] ^ 2 = C.weight [false] ^ 2 := by
    have hsquares : (C.weight [true] ^ 2) ^ 2 = (C.weight [false] ^ 2) ^ 2 := by
      nlinarith [hf]
    rcases (sq_eq_sq_iff_eq_or_eq_neg).mp hsquares with h | h
    · exact h
    · nlinarith [sq_nonneg (C.weight [true]), sq_nonneg (C.weight [false])]
  rcases (sq_eq_sq_iff_eq_or_eq_neg).mp hs with h | h
  · constructor <;> linarith [C.column]
  · linarith [C.column]

theorem weight_word (w : Word) : C.weight w = (1 / 2 : ℝ) ^ w.length := by
  induction w with
  | nil => simpa using C.weight_one
  | cons c w ih =>
    have hc : C.weight [c] = (1 / 2 : ℝ) := by
      cases c
      · exact C.native_weights.2
      · exact C.native_weights.1
    change C.weight ([c] ++ w) = _
    rw [C.multiplicative, hc, ih, List.length_cons, pow_succ']

theorem equal_actions_equal_lengths {x y : Word}
    (he : G.evalWord x = G.evalWord y) : x.length = y.length := by
  have hw := C.extensional he
  rw [C.weight_word, C.weight_word] at hw
  exact (pow_right_strictAnti₀ (by norm_num : (0 : ℝ) < 1 / 2)
    (by norm_num : (1 / 2 : ℝ) < 1)).injective hw

/-- Swapping native branch labels preserves response on this action monoid. -/
theorem reflection_invariant (w : Word) : C.weight (w.map Bool.not) = C.weight w := by
  rw [C.weight_word, C.weight_word, List.length_map]

/-- Only the serial half-word is used. -/
theorem weight_half_power (n : ℕ) :
    C.weight (repeatWord [true, false] n) = (1 / 4 : ℝ) ^ n := by
  rw [C.weight_repeat]
  congr 1
  have hw := C.weight_word [true, false]
  norm_num at hw ⊢
  exact hw

/-- The derived half has distinct powers as actual operators. -/
theorem half_powers_separate (j k : ℕ) (he : G.H ^ j = G.H ^ k) : j = k := by
  have heval : G.evalWord (repeatWord [true, false] j) =
      G.evalWord (repeatWord [true, false] k) := by
    simpa only [evalWord_repeat, Gate.evalWord, Gate.branch, mul_one] using he
  have hw := C.extensional heval
  rw [C.weight_half_power, C.weight_half_power] at hw
  exact (pow_right_strictAnti₀ (by norm_num : (0 : ℝ) < 1 / 4)
    (by norm_num : (1 / 4 : ℝ) < 1)).injective hw

end OperatorResponse

/-- Distinct powers of a genuine half force characteristic zero. This purely
ring-theoretic lemma has no response on an additive sum. -/
theorem charZero_of_half_powers {R : Type*} [Ring R] (h : R)
    (hh : (2 : R) * h = 1)
    (separate : ∀ j k : ℕ, h ^ j = h ^ k → j = k) : CharZero R := by
  have hc : Commute (2 : R) h := by
    show (2 : R) * h = h * (2 : R)
    simp only [two_mul, mul_two]
  have right_inverse : ∀ n : ℕ, (2 : R) ^ n * h ^ n = 1 := by
    intro n
    rw [← hc.mul_pow, hh, one_pow]
  have left_inverse : ∀ n : ℕ, h ^ n * (2 : R) ^ n = 1 := by
    intro n
    rw [← hc.symm.mul_pow, ← hc.eq, hh, one_pow]
  apply charZero_of_inj_zero
  intro n hn
  by_contra hnzero
  have hnpos : 0 < n := Nat.pos_of_ne_zero hnzero
  have reduce : ∀ m : ℕ, ((m % n : ℕ) : R) = (m : R) := by
    intro m
    have he := congrArg (fun q : ℕ => (q : R)) (Nat.mod_add_div m n)
    simpa only [Nat.cast_add, Nat.cast_mul, hn, zero_mul, add_zero] using he
  let f : ℕ → Fin n := fun k => ⟨2 ^ k % n, Nat.mod_lt _ hnpos⟩
  obtain ⟨j, k, hjk, he⟩ := Finite.exists_ne_map_eq_of_infinite f
  have hmod : 2 ^ j % n = 2 ^ k % n := congrArg Fin.val he
  have hcast : (2 : R) ^ j = (2 : R) ^ k := by
    calc
      _ = ((2 ^ j : ℕ) : R) := by norm_cast
      _ = ((2 ^ j % n : ℕ) : R) := (reduce _).symm
      _ = ((2 ^ k % n : ℕ) : R) := congrArg (fun q : ℕ => (q : R)) hmod
      _ = ((2 ^ k : ℕ) : R) := reduce _
      _ = (2 : R) ^ k := by norm_cast
  have hhalf : h ^ j = h ^ k := by
    calc
      h ^ j = (h ^ k * (2 : R) ^ k) * h ^ j := by rw [left_inverse, one_mul]
      _ = h ^ k * ((2 : R) ^ j * h ^ j) := by rw [hcast]; simp only [mul_assoc]
      _ = h ^ k := by rw [right_inverse, mul_one]
  exact hjk (separate j k hhalf)

namespace OperatorResponse

variable {V : Type*} [AddCommMonoid V] {G : Gate V} (C : OperatorResponse G)

include C


/-- Characteristic zero is derived in the actual endomorphism ring. -/
abbrev endCharacteristicZero : CharZero (AddMonoid.End G.Carrier) :=
  charZero_of_half_powers G.H G.double_half C.half_powers_separate

local instance : CommRing G.generated := G.generatedCommRing

/-- The native generated subring inherits the derived characteristic zero. -/
abbrev generatedCharacteristicZero : CharZero G.generated := by
  letI := C.endCharacteristicZero
  apply charZero_of_inj_zero
  intro n hn
  have he : (n : AddMonoid.End G.Carrier) = 0 := congrArg Subtype.val hn
  exact (Nat.cast_eq_zero.mp he)

include C in
theorem arithmetic_parameters :
    G.generatedU ^ 2 = -(1 : G.generated) ∧
    (2 : G.generated) * G.generatedH = 1 ∧
    G.generatedA = G.generatedH * (1 + G.generatedU) ∧
    G.generatedB = G.generatedH * (1 - G.generatedU) := by
  have hu : G.generatedU ^ 2 = -(1 : G.generated) := Subtype.ext G.phase_square
  have hh : (2 : G.generated) * G.generatedH = 1 := Subtype.ext G.double_half
  have ha : G.generatedA = G.generatedH * (1 + G.generatedU) :=
    Subtype.ext G.coefficient_a
  have ht : G.generatedA + G.generatedB = 1 := Subtype.ext G.transparent_coefficients
  refine ⟨hu, hh, ha, ?_⟩
  have hb : G.generatedB = 1 - G.generatedA := by linear_combination ht
  rw [hb, ha]
  linear_combination -hh



/-- The Gaussian-dyadic normal form is faithful as an actual endomorphism. -/
def dyadicOperator : DyadicResponseExtension.Dyadic → AddMonoid.End G.Carrier := by
  letI := C.generatedCharacteristicZero
  exact fun d =>
    ((Arithmetic.dyadicEval G.generatedU G.generatedH
      C.arithmetic_parameters.1 C.arithmetic_parameters.2.1 d : G.generated) :
        AddMonoid.End G.Carrier)

theorem dyadicOperator_injective : Function.Injective C.dyadicOperator := by
  letI := C.generatedCharacteristicZero
  intro x y he
  apply Arithmetic.dyadicEval_injective G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1
  exact Subtype.ext he

/-- This arithmetic subring is initially defined inside the generated ring. -/
abbrev arithmeticSubring : Subring G.generated := by
  letI := C.generatedCharacteristicZero
  exact Arithmetic.generatedSubring G.generatedU G.generatedH
      C.arithmetic_parameters.1 C.arithmetic_parameters.2.1

theorem arithmetic_native_a : G.generatedA ∈ C.arithmeticSubring := by
  letI := C.generatedCharacteristicZero
  have hx := (Arithmetic.generatedA G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).property
  have he : (Arithmetic.generatedA G.generatedU G.generatedH
      C.arithmetic_parameters.1 C.arithmetic_parameters.2.1 : G.generated) =
      G.generatedA :=
    (Arithmetic.generatedA_value G.generatedU G.generatedH
      C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).trans
        C.arithmetic_parameters.2.2.1.symm
  exact he ▸ hx

theorem arithmetic_native_b : G.generatedB ∈ C.arithmeticSubring := by
  letI := C.generatedCharacteristicZero
  have hx := (Arithmetic.generatedB G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).property
  have he : (Arithmetic.generatedB G.generatedU G.generatedH
      C.arithmetic_parameters.1 C.arithmetic_parameters.2.1 : G.generated) =
      G.generatedB :=
    (Arithmetic.generatedB_value G.generatedU G.generatedH
      C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).trans
        C.arithmetic_parameters.2.2.2.symm
  exact he ▸ hx

/-- Exact coverage: every operator in the native generated ring has a
Gaussian-dyadic presentation. This prevents an image-only overclaim. -/
theorem arithmeticSubring_eq_top : C.arithmeticSubring = ⊤ := by
  letI := C.generatedCharacteristicZero
  let image := C.arithmeticSubring.map G.generated.subtype
  have hincl : G.generated ≤ image := by
    apply Subring.closure_le.mpr
    intro e he
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at he
    rcases he with rfl | rfl
    · exact Subring.mem_map.mpr ⟨G.generatedA, C.arithmetic_native_a, rfl⟩
    · exact Subring.mem_map.mpr ⟨G.generatedB, C.arithmetic_native_b, rfl⟩
  apply top_unique
  intro x _
  have hx : (x : AddMonoid.End G.Carrier) ∈ image := hincl x.property
  obtain ⟨y, hy, he⟩ := Subring.mem_map.mp hx
  have heq : y = x := Subtype.ext he
  exact heq ▸ hy

/-- Repackage the proved full image equality without changing operations. -/
def generatedArithmeticEquiv : G.generated ≃+* C.arithmeticSubring where
  toFun x := ⟨x, by rw [C.arithmeticSubring_eq_top]; trivial⟩
  invFun x := x.val
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

/-- Canonical conjugation on the full native generated operator algebra. -/
def canonicalConjugation : G.generated ≃+* G.generated := by
  letI := C.generatedCharacteristicZero
  exact C.generatedArithmeticEquiv.trans
      ((Arithmetic.conjugationEquiv G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).trans
          C.generatedArithmeticEquiv.symm)

theorem canonicalConjugation_a :
    C.canonicalConjugation G.generatedA = G.generatedB := by
  letI := C.generatedCharacteristicZero
  have ha : C.generatedArithmeticEquiv G.generatedA =
      Arithmetic.generatedA G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1 := by
    apply Subtype.ext
    exact C.arithmetic_parameters.2.2.1.trans
      (Arithmetic.generatedA_value G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).symm
  change ((Arithmetic.conjugationEquiv G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1)
      (C.generatedArithmeticEquiv G.generatedA)).val = _
  rw [ha]
  change (Arithmetic.conjugation G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1
      (Arithmetic.generatedA G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1)).val = _
  rw [Arithmetic.conjugation_a, Arithmetic.generatedB_value]
  exact C.arithmetic_parameters.2.2.2.symm

theorem canonicalConjugation_b :
    C.canonicalConjugation G.generatedB = G.generatedA := by
  letI := C.generatedCharacteristicZero
  have hb : C.generatedArithmeticEquiv G.generatedB =
      Arithmetic.generatedB G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1 := by
    apply Subtype.ext
    exact C.arithmetic_parameters.2.2.2.trans
      (Arithmetic.generatedB_value G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1).symm
  change ((Arithmetic.conjugationEquiv G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1)
      (C.generatedArithmeticEquiv G.generatedB)).val = _
  rw [hb]
  change (Arithmetic.conjugation G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1
      (Arithmetic.generatedB G.generatedU G.generatedH
        C.arithmetic_parameters.1 C.arithmetic_parameters.2.1)).val = _
  rw [Arithmetic.conjugation_b, Arithmetic.generatedA_value]
  exact C.arithmetic_parameters.2.2.1.symm

/-- A calibrated serial response cannot extend additively to this operator
algebra: its two cross branches sum to the identity but total only one half.
This concerns coherent operator addition, with no conclusion about probability
additivity for exclusive detector outcomes. -/
theorem no_additive_extension (rho : G.generated → ℝ)
    (agrees : ∀ w, rho (G.generatedWord w) = C.weight w) :
    ¬ (∀ x y, rho (x + y) = rho x + rho y) := by
  intro hadd
  have hcross : G.generatedWord [true, false] + G.generatedWord [false, true] =
      G.generatedWord [] := by
    apply Subtype.ext
    simp only [Gate.generatedWord, Gate.evalWord, Gate.branch, mul_one]
    exact AddMonoidHom.ext G.reconstruction.cross
  have he := congrArg rho hcross
  rw [hadd, agrees, agrees, agrees] at he
  rw [C.weight_word, C.weight_word, C.weight_one] at he
  norm_num at he

theorem canonicalConjugation_involutive :
    Function.Involutive C.canonicalConjugation := by
  letI := C.generatedCharacteristicZero
  intro x
  apply C.generatedArithmeticEquiv.injective
  simp only [canonicalConjugation, RingEquiv.trans_apply, RingEquiv.apply_symm_apply]
  exact Arithmetic.conjugation_involutive G.generatedU G.generatedH
    C.arithmetic_parameters.1 C.arithmetic_parameters.2.1
      (C.generatedArithmeticEquiv x)

end OperatorResponse

/-- The stronger source-specific contract starts with local serial steps.
The reference is supplied without nonzero or torsion-free hypotheses.
Terminal-state equality retains the raw carrier scale, including attenuation.
It does not identify normalized postselected states or projective rays. -/
structure SourceResponse {V : Type*} [AddCommMonoid V] (G : Gate V) where
  reference : G.Carrier
  weight : Word → ℝ
  step : ∀ c w, weight (c :: w) = weight [c] * weight w
  extensional : ∀ {x y}, G.evalWord x reference = G.evalWord y reference →
    weight x = weight y
  column : weight [true] + weight [false] = 1

namespace SourceResponse

variable {V : Type*} [AddCommMonoid V] {G : Gate V} (C : SourceResponse G)

include C

theorem weight_one : C.weight [] = 1 := by
  have ha := C.step true []
  have hb := C.step false []
  have he : 1 = 1 * C.weight [] := by
    calc
      1 = C.weight [true] + C.weight [false] := C.column.symm
      _ = (C.weight [true] + C.weight [false]) * C.weight [] := by
        rw [add_mul, ← ha, ← hb]
      _ = 1 * C.weight [] := by rw [C.column]
  simpa only [one_mul] using he.symm

theorem weight_append (x y : Word) :
    C.weight (x ++ y) = C.weight x * C.weight y := by
  induction x with
  | nil => simp [C.weight_one]
  | cons c x ih =>
    calc
      C.weight ((c :: x) ++ y) = C.weight [c] * C.weight (x ++ y) :=
        C.step c (x ++ y)
      _ = C.weight [c] * (C.weight x * C.weight y) := by rw [ih]
      _ = C.weight (c :: x) * C.weight y := by rw [C.step c x, mul_assoc]

/-- Terminal-state equality at the reference implies action extensionality.
This adapter obtains the weaker operator contract from the stronger source contract. -/
def operatorResponse : OperatorResponse G where
  weight := C.weight
  multiplicative := C.weight_append
  extensional := fun he => C.extensional (DFunLike.congr_fun he C.reference)
  column := C.column

theorem native_weights : C.weight [true] = 1 / 2 ∧ C.weight [false] = 1 / 2 :=
  C.operatorResponse.native_weights

theorem weight_word (w : Word) : C.weight w = (1 / 2 : ℝ) ^ w.length :=
  C.operatorResponse.weight_word w

theorem equal_terminal_states_equal_lengths {x y : Word}
    (he : G.evalWord x C.reference = G.evalWord y C.reference) :
    x.length = y.length := by
  have hw := C.extensional he
  rw [C.weight_word, C.weight_word] at hw
  exact (pow_right_strictAnti₀ (by norm_num : (0 : ℝ) < 1 / 2)
    (by norm_num : (1 / 2 : ℝ) < 1)).injective hw


/-- The source has infinite additive order, derived from word response.
No response is applied to an integer multiple or a sum. -/
theorem reference_nat_torsion_free (n : ℕ) (hn : n • C.reference = 0) : n = 0 := by
  by_contra hnzero
  have hnpos : 0 < n := Nat.pos_of_ne_zero hnzero
  have reduce : ∀ m : ℕ, (m % n) • C.reference = m • C.reference := by
    intro m
    have hm : (n * (m / n)) • C.reference = 0 := by
      rw [Nat.mul_comm, mul_smul, hn, smul_zero]
    calc
      (m % n) • C.reference = (m % n) • C.reference + (n * (m / n)) • C.reference := by
        rw [hm, add_zero]
      _ = m • C.reference := by rw [← add_smul, Nat.mod_add_div]
  let f : ℕ → Fin n := fun k => ⟨2 ^ k % n, Nat.mod_lt _ hnpos⟩
  obtain ⟨j, k, hjk, he⟩ := Finite.exists_ne_map_eq_of_infinite f
  have hmod : 2 ^ j % n = 2 ^ k % n := congrArg Fin.val he
  have h2v : ((2 : AddMonoid.End G.Carrier) ^ j) C.reference =
      ((2 : AddMonoid.End G.Carrier) ^ k) C.reference := by
    calc
      _ = (2 ^ j : ℕ) • C.reference := by
        have hc : (2 : AddMonoid.End G.Carrier) ^ j =
            ((2 ^ j : ℕ) : AddMonoid.End G.Carrier) := by norm_cast
        rw [hc, AddMonoid.End.natCast_apply]
      _ = (2 ^ j % n) • C.reference := (reduce _).symm
      _ = (2 ^ k % n) • C.reference := congrArg (fun m : ℕ => m • C.reference) hmod
      _ = (2 ^ k : ℕ) • C.reference := reduce _
      _ = _ := by
        have hc : (2 : AddMonoid.End G.Carrier) ^ k =
            ((2 ^ k : ℕ) : AddMonoid.End G.Carrier) := by norm_cast
        rw [hc, AddMonoid.End.natCast_apply]
  have hc : Commute (2 : AddMonoid.End G.Carrier) G.H := by
    show (2 : AddMonoid.End G.Carrier) * G.H = G.H * 2
    simp only [two_mul, mul_two]
  have hinv : ∀ m : ℕ, G.H ^ m * (2 : AddMonoid.End G.Carrier) ^ m = 1 := by
    intro m
    rw [← hc.symm.mul_pow, ← hc.eq, G.double_half, one_pow]
  have hj : G.H ^ (j + k) * (2 : AddMonoid.End G.Carrier) ^ j = G.H ^ k := by
    rw [Nat.add_comm j k, pow_add, mul_assoc, hinv, mul_one]
  have hk : G.H ^ (j + k) * (2 : AddMonoid.End G.Carrier) ^ k = G.H ^ j := by
    rw [pow_add, mul_assoc, hinv, mul_one]
  have hhalf := congrArg (fun x => (G.H ^ (j + k)) x) h2v
  change (G.H ^ (j + k) * (2 : AddMonoid.End G.Carrier) ^ j) C.reference =
    (G.H ^ (j + k) * (2 : AddMonoid.End G.Carrier) ^ k) C.reference at hhalf
  rw [hj, hk] at hhalf
  have hw : G.evalWord (repeatWord [true, false] k) C.reference =
      G.evalWord (repeatWord [true, false] j) C.reference := by
    simpa only [evalWord_repeat, Gate.evalWord, Gate.branch, mul_one] using hhalf
  have hlen := C.equal_terminal_states_equal_lengths hw
  simp only [repeatWord_length, List.length_cons, List.length_nil] at hlen
  exact hjk (by omega)

theorem reference_int_torsion_free (n : ℤ) (hn : n • C.reference = 0) : n = 0 := by
  have habs : n.natAbs • C.reference = 0 := (natAbs_nsmul_eq_zero).mpr hn
  exact Int.natAbs_eq_zero.mp (C.reference_nat_torsion_free n.natAbs habs)

theorem reference_nonzero : C.reference ≠ 0 := by
  intro he
  have hn := C.reference_nat_torsion_free 1 (by simp [he])
  omega

local instance : CommRing G.generated := G.generatedCommRing

/-- Evaluation on the native generated operator algebra at the supplied source.
This definition does not identify this image with physically preparable states. -/
def evaluate (x : G.generated) : G.Carrier := (x : AddMonoid.End G.Carrier) C.reference

theorem gaussian_evaluation_zero_iff (z : LocalHistoryReadoutOrderWall.Residual) :
    C.evaluate (Arithmetic.gaussian G.generatedU z) = 0 ↔ z = 0 := by
  letI := C.operatorResponse.generatedCharacteristicZero
  constructor
  · intro hz
    let m : ℤ := z.1
    let n : ℤ := z.2
    have hu := C.operatorResponse.arithmetic_parameters.1
    have hp : ((m : G.generated) - (n : G.generated) * G.generatedU) *
        Arithmetic.gaussian G.generatedU z = ((m * m + n * n : ℤ) : G.generated) := by
      dsimp [Arithmetic.gaussian, m, n]
      push_cast
      linear_combination -(z.2 : G.generated) ^ 2 * hu
    have he := congrArg
      (fun x : G.Carrier => (((m : G.generated) - (n : G.generated) * G.generatedU :
        G.generated) : AddMonoid.End G.Carrier) x) hz
    change (((((m : G.generated) - (n : G.generated) * G.generatedU) *
      Arithmetic.gaussian G.generatedU z : G.generated) : AddMonoid.End G.Carrier)
        C.reference) = _ at he
    rw [hp] at he
    simp only [map_zero] at he
    have hsmul : (m * m + n * n : ℤ) • C.reference = 0 := by
      simpa only [Subring.coe_intCast, AddMonoid.End.intCast_apply] using he
    have hmn := C.reference_int_torsion_free _ hsmul
    have hm : m = 0 := by nlinarith [sq_nonneg m, sq_nonneg n]
    have hn : n = 0 := by nlinarith [sq_nonneg m, sq_nonneg n]
    apply Prod.ext
    · exact hm
    · exact hn
  · rintro rfl
    simp [evaluate, Arithmetic.gaussian]

theorem gaussian_evaluation_injective :
    Function.Injective (fun z : LocalHistoryReadoutOrderWall.Residual =>
      C.evaluate (Arithmetic.gaussian G.generatedU z)) := by
  letI := C.operatorResponse.generatedCharacteristicZero
  intro z t he
  have hz : C.evaluate (Arithmetic.gaussian G.generatedU (z - t)) = 0 := by
    rw [sub_eq_add_neg, Arithmetic.gaussian_add, Arithmetic.gaussian_neg]
    change C.evaluate (Arithmetic.gaussian G.generatedU z) -
      C.evaluate (Arithmetic.gaussian G.generatedU t) = 0
    exact sub_eq_zero.mpr he
  exact sub_eq_zero.mp ((C.gaussian_evaluation_zero_iff _).mp hz)

/-- Denominators are cleared by operator action, with no response on sums. -/
theorem value_evaluation_eq_iff (k l : ℕ)
    (z t : LocalHistoryReadoutOrderWall.Residual) :
    C.evaluate (Arithmetic.value G.generatedU G.generatedH k z) =
      C.evaluate (Arithmetic.value G.generatedU G.generatedH l t) ↔
        DyadicResponseExtension.scale l z = DyadicResponseExtension.scale k t := by
  letI := C.operatorResponse.generatedCharacteristicZero
  constructor
  · intro he
    have hclear := congrArg
      (fun v : G.Carrier => (((2 : G.generated) ^ (k + l) : G.generated) : AddMonoid.End G.Carrier) v) he
    change C.evaluate ((2 : G.generated) ^ (k + l) *
      Arithmetic.value G.generatedU G.generatedH k z) =
      C.evaluate ((2 : G.generated) ^ (k + l) *
        Arithmetic.value G.generatedU G.generatedH l t) at hclear
    rw [Arithmetic.clear_denominator G.generatedU G.generatedH
      C.operatorResponse.arithmetic_parameters.2.1 k l z,
      Nat.add_comm k l,
      Arithmetic.clear_denominator G.generatedU G.generatedH
        C.operatorResponse.arithmetic_parameters.2.1 l k t] at hclear
    exact C.gaussian_evaluation_injective hclear
  · intro he
    exact congrArg C.evaluate
      ((Arithmetic.value_eq_iff G.generatedU G.generatedH
        C.operatorResponse.arithmetic_parameters.1
        C.operatorResponse.arithmetic_parameters.2.1 k l z t).mpr he)

/-- Stronger than operator faithfulness: this particular reference separates
all operators in the native generated algebra. This needs SourceResponse. -/
theorem generatedEvaluation_injective : Function.Injective C.evaluate := by
  letI := C.operatorResponse.generatedCharacteristicZero
  intro x y he
  obtain ⟨k, z, hx⟩ := Arithmetic.presentation_exists G.generatedU G.generatedH
    C.operatorResponse.arithmetic_parameters.1
    C.operatorResponse.arithmetic_parameters.2.1
    (C.operatorResponse.generatedArithmeticEquiv x)
  obtain ⟨l, t, hy⟩ := Arithmetic.presentation_exists G.generatedU G.generatedH
    C.operatorResponse.arithmetic_parameters.1
    C.operatorResponse.arithmetic_parameters.2.1
    (C.operatorResponse.generatedArithmeticEquiv y)
  have hxv : x = Arithmetic.value G.generatedU G.generatedH k z :=
    congrArg Subtype.val hx
  have hyv : y = Arithmetic.value G.generatedU G.generatedH l t :=
    congrArg Subtype.val hy
  rw [hxv, hyv] at he ⊢
  exact (Arithmetic.value_eq_iff G.generatedU G.generatedH
    C.operatorResponse.arithmetic_parameters.1
    C.operatorResponse.arithmetic_parameters.2.1 k l z t).mpr
      ((C.value_evaluation_eq_iff k l z t).mp he)

/-- The Gaussian-dyadic arithmetic is faithful at this supplied reference. -/
theorem dyadicReference_injective : Function.Injective
    (fun d => C.operatorResponse.dyadicOperator d C.reference) := by
  letI := C.operatorResponse.generatedCharacteristicZero
  intro x y he
  apply C.operatorResponse.dyadicOperator_injective
  have hgen :
      Arithmetic.dyadicEval G.generatedU G.generatedH
        C.operatorResponse.arithmetic_parameters.1
        C.operatorResponse.arithmetic_parameters.2.1 x =
      Arithmetic.dyadicEval G.generatedU G.generatedH
        C.operatorResponse.arithmetic_parameters.1
        C.operatorResponse.arithmetic_parameters.2.1 y :=
    C.generatedEvaluation_injective he
  exact congrArg Subtype.val hgen

end SourceResponse

namespace Controls

/-- The finite coefficient model satisfies the operation laws, but its short
word collapse obstructs an extensional calibrated serial response. -/
def finiteGate : Gate FiniteScalarReversalBoundary.Scalar where
  operation := {
    toFun := FiniteScalarReversalBoundary.forward
    map_zero' := by simp [FiniteScalarReversalBoundary.forward]
    map_add' := FiniteScalarReversalBoundary.forward_additive }
  transparent := FiniteScalarReversalBoundary.diagonal
  square := FiniteScalarReversalBoundary.square_swap

theorem finite_a_square : finiteGate.evalWord [true, true] = finiteGate.evalWord [] := by
  apply AddMonoidHom.ext
  intro x
  change FiniteScalarReversalBoundary.a *
    (FiniteScalarReversalBoundary.a * (show FiniteScalarReversalBoundary.Scalar from x) +
      FiniteScalarReversalBoundary.b * 0) +
    FiniteScalarReversalBoundary.b * 0 = x
  have ha : FiniteScalarReversalBoundary.a * FiniteScalarReversalBoundary.a = 1 := by decide
  rw [mul_zero, add_zero, add_zero, ← mul_assoc, ha, one_mul]

theorem finite_no_operator_response : ¬ Nonempty (OperatorResponse finiteGate) := by
  rintro ⟨C⟩
  have he := C.equal_actions_equal_lengths finite_a_square
  norm_num at he

theorem finite_no_source_response : ¬ Nonempty (SourceResponse finiteGate) := by
  rintro ⟨C⟩
  exact finite_no_operator_response ⟨C.operatorResponse⟩

end Controls

namespace ConsistencyWitness

/-- Fixed complex coefficients are used only in this explicit model. -/
def a : ℂ := ⟨1 / 2, 1 / 2⟩
def b : ℂ := ⟨1 / 2, -(1 / 2)⟩

theorem coefficient_laws : a + b = 1 ∧ a * a + b * b = 0 ∧
    a * b + b * a = 1 := by
  constructor
  · apply Complex.ext <;> norm_num [a, b]
  constructor <;> apply Complex.ext <;> norm_num [a, b]

def operation : (ℂ × ℂ) →+ (ℂ × ℂ) where
  toFun p := (a * p.1 + b * p.2, b * p.1 + a * p.2)
  map_zero' := by simp
  map_add' p q := by ext <;> dsimp <;> ring

theorem transparent (x : ℂ) : operation (x, x) = (x, x) := by
  apply Prod.ext
  · change a * x + b * x = x
    rw [← add_mul, coefficient_laws.1, one_mul]
  · change b * x + a * x = x
    rw [add_comm, ← add_mul, coefficient_laws.1, one_mul]

theorem square (p : ℂ × ℂ) : operation (operation p) = p.swap := by
  apply Prod.ext
  · change a * (a * p.1 + b * p.2) + b * (b * p.1 + a * p.2) = p.2
    calc
      _ = (a * a + b * b) * p.1 + (a * b + b * a) * p.2 := by ring
      _ = _ := by rw [coefficient_laws.2.1, coefficient_laws.2.2]; simp
  · change b * (a * p.1 + b * p.2) + a * (b * p.1 + a * p.2) = p.1
    calc
      _ = (a * b + b * a) * p.1 + (a * a + b * b) * p.2 := by ring
      _ = _ := by rw [coefficient_laws.2.1, coefficient_laws.2.2]; simp

def gate : Gate ℂ := ⟨operation, transparent, square⟩

def scalar : Bool → ℂ
  | true => a
  | false => b

def scalarWord : Word → ℂ
  | [] => 1
  | c :: w => scalar c * scalarWord w

theorem word_action (w : Word) (x : ℂ) : gate.evalWord w x = scalarWord w * x := by
  induction w with
  | nil => simp [Gate.evalWord, scalarWord]
  | cons c w ih =>
    cases c
    · change b * (show ℂ from gate.evalWord w x) + a * 0 = (b * scalarWord w) * x
      rw [ih, mul_zero, add_zero, mul_assoc]
    · change a * (show ℂ from gate.evalWord w x) + b * 0 = (a * scalarWord w) * x
      rw [ih, mul_zero, add_zero, mul_assoc]

/-- The local serial response is defined directly in the model. Its
verification does not apply the universal reconstruction to itself. -/
def sourceResponse : SourceResponse gate where
  reference := (1 : ℂ)
  weight w := Complex.normSq (scalarWord w)
  step c w := by
    simp only [scalarWord, Complex.normSq_mul, mul_one]
  extensional := by
    intro x y he
    have hs : scalarWord x = scalarWord y := by
      simpa only [word_action, mul_one] using he
    exact congrArg Complex.normSq hs
  column := by norm_num [scalarWord, scalar, a, b, Complex.normSq_apply]

/-- Simultaneous nonvacuity with a nonzero reference, independently checked
inside the supplied concrete arithmetic model. -/
theorem nontrivial_contract :
    Nonempty (SourceResponse gate) ∧ (1 : ℂ) ≠ 0 :=
  ⟨⟨sourceResponse⟩, one_ne_zero⟩

theorem operator_contract : Nonempty (OperatorResponse gate) :=
  ⟨sourceResponse.operatorResponse⟩

end ConsistencyWitness

end

