import Mathlib.Data.Real.Archimedean
import Mathlib.Order.ConditionallyCompleteLattice.Basic
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp

namespace IDT.QMClosure.ScalarActualizationRefinement

noncomputable section

open scoped BigOperators

/-!
# Conditional scalar actualization from event-label refinement

A single scalar response on all real normalized weights is supplied, shared
across preparations and contexts. Probability bounds, complement accounting,
and balanced splitting of event labels force this response to be the identity.
No continuity, additivity, multiplicativity, or measurability is assumed.

The real-weight domain and these actual-event accounting laws are additional
assumptions. They are not derived from raw operational data, reconstructed
Hilbert structure, or effects. Event-label refinement is not coherent amplitude
recombination. No actual random selector, Born-rule closure, or full QM is
constructed here. A dense restricted domain alone is not the stated domain.
-/

/-- A bounded real error with complement antisymmetry and exact halving vanishes
on the full real unit interval. Completeness is used only for a bounded supremum;
no regularity of the error function is required. -/
theorem bounded_error_eq_zero
    (h : ℝ → ℝ)
    (bounded : ∃ C : ℝ, ∀ t ∈ Set.Icc (0 : ℝ) 1, |h t| ≤ C)
    (complement : ∀ t ∈ Set.Icc (0 : ℝ) 1, h (1 - t) = -h t)
    (half : ∀ t ∈ Set.Icc (0 : ℝ) 1, h (t / 2) = h t / 2)
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) : h t = 0 := by
  let S : Set ℝ := (fun u => |h u|) '' Set.Icc (0 : ℝ) 1
  have nonempty : S.Nonempty := ⟨|h 0|, 0, ⟨le_rfl, by norm_num⟩, rfl⟩
  obtain ⟨C, hC⟩ := bounded
  have bdd : BddAbove S := by
    refine ⟨C, ?_⟩
    rintro _ ⟨u, hu, rfl⟩
    exact hC u hu
  have upper (u : ℝ) (hu : u ∈ Set.Icc (0 : ℝ) 1) : |h u| ≤ sSup S :=
    le_csSup bdd ⟨u, hu, rfl⟩
  have contract (u : ℝ) (hu : u ∈ Set.Icc (0 : ℝ) 1) :
      |h u| ≤ sSup S / 2 := by
    rcases hu with ⟨hu0, hu1⟩
    by_cases low : u ≤ 1 / 2
    · have hv : 2 * u ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith, by linarith⟩
      have hh := half (2 * u) hv
      rw [show 2 * u / 2 = u by ring] at hh
      obtain ⟨hl, hr⟩ := abs_le.mp (upper (2 * u) hv)
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · have hv : 2 - 2 * u ∈ Set.Icc (0 : ℝ) 1 :=
        ⟨by linarith, by linarith⟩
      have hh := half (2 - 2 * u) hv
      rw [show (2 - 2 * u) / 2 = 1 - u by ring] at hh
      rw [complement u ⟨hu0, hu1⟩] at hh
      obtain ⟨hl, hr⟩ := abs_le.mp (upper (2 - 2 * u) hv)
      exact abs_le.mpr ⟨by linarith, by linarith⟩
  have sup_contract : sSup S ≤ sSup S / 2 := by
    apply csSup_le nonempty
    rintro _ ⟨u, hu, rfl⟩
    exact contract u hu
  have zero_bound : |h t| ≤ 0 := by
    have := upper t ht
    linarith
  exact abs_eq_zero.mp (le_antisymm zero_bound (abs_nonneg _))

/-- A universal scalar probability response satisfying complement and balanced
event-label refinement is the identity at every real normalized weight. -/
theorem probability_response_eq_weight
    (F : ℝ → ℝ)
    (probability : ∀ t ∈ Set.Icc (0 : ℝ) 1, 0 ≤ F t ∧ F t ≤ 1)
    (complement : ∀ t ∈ Set.Icc (0 : ℝ) 1, F (1 - t) = 1 - F t)
    (half : ∀ t ∈ Set.Icc (0 : ℝ) 1, F (t / 2) = F t / 2)
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) : F t = t := by
  have error : F t - t = 0 := by
    apply bounded_error_eq_zero (fun u => F u - u) ?_ ?_ ?_ t ht
    · refine ⟨1, ?_⟩
      intro u hu
      obtain ⟨hF0, hF1⟩ := probability u hu
      exact abs_le.mpr ⟨by linarith [hu.1, hu.2], by linarith [hu.1, hu.2]⟩
    · intro u hu
      dsimp
      rw [complement u hu]
      ring
    · intro u hu
      dsimp
      rw [half u hu]
      ring
  linarith

/-- Optional numerical adapter. Both the shared scalar response and the actual
event-probability assignment are supplied, rather than generated by effects. -/
theorem supplied_finite_event_probability
    {R : Type*} [Fintype R] (q p : R → ℝ)
    (nonnegative : ∀ r, 0 ≤ q r) (total_positive : 0 < ∑ r, q r)
    (F : ℝ → ℝ)
    (probability : ∀ t ∈ Set.Icc (0 : ℝ) 1, 0 ≤ F t ∧ F t ≤ 1)
    (complement : ∀ t ∈ Set.Icc (0 : ℝ) 1, F (1 - t) = 1 - F t)
    (half : ∀ t ∈ Set.Icc (0 : ℝ) 1, F (t / 2) = F t / 2)
    (assignment : ∀ r, p r = F (q r / ∑ s, q s)) (r : R) :
    p r = q r / ∑ s, q s := by
  classical
  rw [assignment r]
  apply probability_response_eq_weight F probability complement half
  constructor
  · exact div_nonneg (nonnegative r) (le_of_lt total_positive)
  · apply (div_le_one total_positive).mpr
    exact Finset.single_le_sum (fun s _ => nonnegative s) (Finset.mem_univ r)

/-- An exact nonlinear normalized square response, used only as a scalar
negative control. No general no-signalling property is asserted. -/
def squaredResponse (t : ℝ) : ℝ := t ^ 2 / (t ^ 2 + (1 - t) ^ 2)

theorem squared_denominator_pos (t : ℝ) : 0 < t ^ 2 + (1 - t) ^ 2 := by
  nlinarith [sq_nonneg (t - 1 / 2)]

theorem squared_response_probability (t : ℝ) :
    0 ≤ squaredResponse t ∧ squaredResponse t ≤ 1 := by
  constructor
  · exact div_nonneg (sq_nonneg t) (le_of_lt (squared_denominator_pos t))
  · exact (div_le_one (squared_denominator_pos t)).mpr
      (by nlinarith [sq_nonneg (1 - t)])

theorem squared_response_complement (t : ℝ) :
    squaredResponse (1 - t) = 1 - squaredResponse t := by
  unfold squaredResponse
  rw [show 1 - (1 - t) = t by ring]
  have h := ne_of_gt (squared_denominator_pos t)
  have h' : (1 - t) ^ 2 + t ^ 2 ≠ 0 := by nlinarith [squared_denominator_pos t]
  field_simp [h, h']
  ring

theorem squared_response_quarter : squaredResponse (1 / 4) = 1 / 10 := by
  norm_num [squaredResponse]

theorem squared_response_half : squaredResponse (1 / 2) = 1 / 2 := by
  norm_num [squaredResponse]

theorem squared_response_fails_balanced_split :
    squaredResponse ((1 / 2) / 2) ≠ squaredResponse (1 / 2) / 2 := by
  norm_num [squaredResponse]

/-- Squaring and renormalizing each record violates event-label refinement:
coarse weights `(1/2,1/2)` versus fine weights `(1/4,1/4,1/2)`. -/
theorem squared_weight_refinement_counterexample :
    ((1 / 2 : ℚ) ^ 2 / ((1 / 2) ^ 2 + (1 / 2) ^ 2) = 1 / 2) ∧
    (((1 / 4 : ℚ) ^ 2 + (1 / 4) ^ 2) /
      ((1 / 4) ^ 2 + (1 / 4) ^ 2 + (1 / 2) ^ 2) = 1 / 3) ∧
    (1 / 2 : ℚ) ≠ 1 / 3 := by
  norm_num

end

end IDT.QMClosure.ScalarActualizationRefinement
