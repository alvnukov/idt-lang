import Mathlib.Tactic

namespace IDT
namespace QMClosure

/-!
# Vanishing third-order interference IS pairwise generation

`ArityBoundsInterferenceOrder` proved one direction over three alternatives:
a readout generated by a kernel on pairs has identically vanishing three-path
interference, and recorded the converse
(`proveTheConverseFromVanishingThirdOrderToBinaryGeneration`) as an open
obligation. This file proves both directions for every finite carrier,
together with the fourth-order closure and the product lemma.

Setup. A weight is a set function `mu : Finset α → ℚ` with `mu ∅ = 0`. The
Sorkin third-order term over three pairwise disjoint nonempty parts is

    sorkinI3 mu A B C
      = mu (A ∪ B ∪ C) - mu (A ∪ B) - mu (A ∪ C) - mu (B ∪ C)
        + mu A + mu B + mu C,

and a weight is pairwise generated when

    mu S = (∑ i in S, a i) + (∑ p in S.offDiag, b p.1 p.2)

for a singleton coefficient function `a` and an ordered-pair coefficient
function `b`. On the `0/1` selection flags of the three-alternative files the
ordered-pair sum is the `kernelWeight` shape, with the diagonal of the kernel
playing the singleton part; `mu ∅ = 0` matches the empty selection.

Main theorem, both directions over an arbitrary carrier: `mu` is pairwise
generated if and only if `sorkinI3 mu A B C = 0` for all pairwise disjoint
nonempty `A`, `B`, `C`. So the Sorkin grade of a weight is exactly the maximal
arity of its generating data: terminating at second order and being generated
by pairs are the same property, not two.

Method. The forward direction linearises every sum against the fixed universe
`A ∪ B ∪ C` through the membership indicator `ind`; the alternating
coefficient of each generating datum is then a polynomial identity, closed by
`ring` with no case analysis. The converse constructs the coefficients
explicitly (`a i = mu {i}`, `b i j = (mu {i, j} - mu {i} - mu {j}) / 2`) and
runs an induction on the card of the selection: a three-part split of a set of
card at least three turns the hypothesis `sorkinI3 mu = 0` into a
determination of `mu S` by proper subsets, and the generated part satisfies
the same identity by the forward direction, so the difference vanishes.

Fourth order. The same indicator method shows that a pairwise generated
weight has vanishing fourth-order term for all pairwise disjoint nonempty
quadruples: closure at second order closes the hierarchy's next test too, and
no new postulate is needed for it.

Product lemma. The pointwise product of two additive weights is pairwise
generated, reproducing the observation of Guo-Cao-Chen-Yin (2011) that a
product of grade-one measures is grade two, now as a corollary of the
equivalence machinery rather than a separate construction.

Scope. Set-function weights over ℚ, no complex amplitudes, no positivity, no
symmetry, no Hilbert carrier, no Born rule beyond the exponent selection
already recorded elsewhere. Whether stable distinguishability in the
primitive base IS such a weight remains open: the base still has no
semantics, so this file characterises a class of readouts, it does not derive
one.
-/

variable {α : Type} [DecidableEq α]

/-- Membership indicator of a set, valued in ℚ. -/
def ind (S : Finset α) (x : α) : ℚ := if x ∈ S then (1 : ℚ) else 0

theorem disjoint_notMem (A B : Finset α) (h : Disjoint A B)
    {x : α} (hA : x ∈ A) : x ∉ B := by
  intro hx
  rw [Finset.disjoint_iff_inter_eq_empty] at h
  have hmem : x ∈ A ∩ B := Finset.mem_inter.mpr ⟨hA, hx⟩
  rw [h] at hmem
  exact absurd hmem (by simp)

theorem disjoint_intro (A B : Finset α) (h : ∀ x, x ∈ A → x ∉ B) :
    Disjoint A B := by
  rw [Finset.disjoint_iff_inter_eq_empty]
  ext x
  simp only [Finset.mem_inter]
  by_cases hx : x ∈ A ∧ x ∈ B
  · exact (h x hx.1 hx.2).elim
  · simp [hx]

theorem ind_union (A B : Finset α) (h : Disjoint A B) (x : α) :
    ind (A ∪ B) x = ind A x + ind B x := by
  unfold ind
  by_cases hA : x ∈ A
  · have hxB : x ∉ B := disjoint_notMem A B h hA
    simp [Finset.mem_union, hA, hxB]
  · by_cases hB : x ∈ B
    · simp [Finset.mem_union, hA, hB]
    · simp [Finset.mem_union, hA, hB]

theorem mem3_left (A B C : Finset α) {x : α} (h : x ∈ A) : x ∈ A ∪ B ∪ C :=
  Finset.mem_union_left _ (Finset.mem_union_left _ h)

theorem mem3_mid (A B C : Finset α) {x : α} (h : x ∈ B) : x ∈ A ∪ B ∪ C :=
  Finset.mem_union_left _ (Finset.mem_union_right _ h)

theorem mem3_right (A B C : Finset α) {x : α} (h : x ∈ C) : x ∈ A ∪ B ∪ C :=
  Finset.mem_union_right _ h

theorem mem4_A (A B C D : Finset α) {x : α} (h : x ∈ A) : x ∈ A ∪ B ∪ C ∪ D :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ h))

theorem mem4_B (A B C D : Finset α) {x : α} (h : x ∈ B) : x ∈ A ∪ B ∪ C ∪ D :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ h))

theorem mem4_C (A B C D : Finset α) {x : α} (h : x ∈ C) : x ∈ A ∪ B ∪ C ∪ D :=
  Finset.mem_union_left _ (Finset.mem_union_right _ h)

theorem mem4_D (A B C D : Finset α) {x : α} (h : x ∈ D) : x ∈ A ∪ B ∪ C ∪ D :=
  Finset.mem_union_right _ h

/-- Sorkin's third-order interference term over three pairwise disjoint
nonempty parts. -/
def sorkinI3 (mu : Finset α → ℚ) (A B C : Finset α) : ℚ :=
  mu (A ∪ B ∪ C) - mu (A ∪ B) - mu (A ∪ C) - mu (B ∪ C)
    + mu A + mu B + mu C

/-- Sorkin's fourth-order interference term over four pairwise disjoint
nonempty parts. -/
def sorkinI4 (mu : Finset α → ℚ) (A B C D : Finset α) : ℚ :=
  mu (A ∪ B ∪ C ∪ D)
    - mu (A ∪ B ∪ C) - mu (A ∪ B ∪ D) - mu (A ∪ C ∪ D) - mu (B ∪ C ∪ D)
    + mu (A ∪ B) + mu (A ∪ C) + mu (A ∪ D)
        + mu (B ∪ C) + mu (B ∪ D) + mu (C ∪ D)
    - mu A - mu B - mu C - mu D

/--
A weight is pairwise generated when it is the sum of a singleton part and an
ordered-pair kernel part. On `0/1` selection flags this is the `kernelWeight`
shape of `ArityBoundsInterferenceOrder`.
-/
def TwoDecomposable (mu : Finset α → ℚ) : Prop :=
  ∃ a : α → ℚ, ∃ b : α → α → ℚ,
    ∀ S : Finset α,
      mu S = (∑ i ∈ S, a i) + (∑ p ∈ S.offDiag, b p.1 p.2)

theorem sorkinI3_add (f g : Finset α → ℚ) (A B C : Finset α) :
    sorkinI3 (fun S => f S + g S) A B C = sorkinI3 f A B C + sorkinI3 g A B C := by
  unfold sorkinI3
  ring

theorem sorkinI3_sub (f g : Finset α → ℚ) (A B C : Finset α) :
    sorkinI3 (fun S => f S - g S) A B C = sorkinI3 f A B C - sorkinI3 g A B C := by
  unfold sorkinI3
  ring

theorem sorkinI3_sum_singleton (a : α → ℚ) (A B C : Finset α)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hBC : Disjoint B C) :
    sorkinI3 (fun S => ∑ i ∈ S, a i) A B C = 0 := by
  have hABC : Disjoint (A ∪ B) C := Finset.disjoint_union_left.mpr ⟨hAC, hBC⟩
  simp only [sorkinI3, Finset.sum_union hAB, Finset.sum_union hAC,
    Finset.sum_union hBC, Finset.sum_union hABC]
  ring

theorem offDiag_empty : (∅ : Finset α).offDiag = ∅ := by
  ext p
  simp

theorem offDiag_singleton (i : α) : ({i} : Finset α).offDiag = ∅ := by
  ext p
  simp [Finset.mem_offDiag]

theorem offDiag_pair (i j : α) (hij : i ≠ j) :
    ({i, j} : Finset α).offDiag
      = insert (i, j) (insert (j, i) (∅ : Finset (α × α))) := by
  ext p
  simp only [Finset.mem_offDiag, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨(h1 | h1), (h2 | h2), hne⟩
    · exact absurd (h1.trans h2.symm) hne
    · exact Or.inl (Prod.ext h1 h2)
    · exact Or.inr (Or.inl (Prod.ext h1 h2))
    · exact absurd (h1.trans h2.symm) hne
  · rintro (h | h | h)
    · rw [h]
      exact ⟨Or.inl rfl, Or.inr rfl, hij⟩
    · rw [h]
      exact ⟨Or.inr rfl, Or.inl rfl, fun h' => hij h'.symm⟩
    · exact absurd h (by simp)

/--
Linearisation of an ordered-pair sum against a fixed universe: for `S ⊆ T`
the sum over `S.offDiag` equals the sum over `T.offDiag` weighted by the
indicator product of the two endpoints.
-/
theorem offDiag_sum_ind (S T : Finset α) (hST : S ⊆ T) (b : α → α → ℚ) :
    ∑ p ∈ S.offDiag, b p.1 p.2
      = ∑ p ∈ T.offDiag, ind S p.1 * ind S p.2 * b p.1 p.2 := by
  classical
  have hmono : S.offDiag ⊆ T.offDiag := by
    intro p hp
    obtain ⟨h1, h2, hne⟩ := Finset.mem_offDiag.mp hp
    exact Finset.mem_offDiag.mpr ⟨hST h1, hST h2, hne⟩
  have e0 : ∑ p ∈ S.offDiag, b p.1 p.2
      = ∑ p ∈ S.offDiag, (if p ∈ S.offDiag then b p.1 p.2 else 0) :=
    Finset.sum_congr rfl (fun p hp => by simp [hp])
  rw [e0, Finset.sum_subset hmono (fun p _ hnp => by simp [hnp])]
  refine Finset.sum_congr rfl fun p hp => ?_
  by_cases hmem : p ∈ S.offDiag
  · obtain ⟨h1, h2, -⟩ := Finset.mem_offDiag.mp hmem
    simp [ind, h1, h2, hmem]
  · have hpne : p.1 ≠ p.2 := (Finset.mem_offDiag.mp hp).2.2
    by_cases h1 : p.1 ∈ S
    · by_cases h2 : p.2 ∈ S
      · exact absurd (Finset.mem_offDiag.mpr ⟨h1, h2, hpne⟩) hmem
      · simp [ind, h2, hmem]
    · simp [ind, h1, hmem]

theorem sorkinI3_sum_offDiag (b : α → α → ℚ) (A B C : Finset α)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hBC : Disjoint B C) :
    sorkinI3 (fun S => ∑ p ∈ S.offDiag, b p.1 p.2) A B C = 0 := by
  classical
  have hABC : Disjoint (A ∪ B) C := Finset.disjoint_union_left.mpr ⟨hAC, hBC⟩
  have hsubAB : A ∪ B ⊆ A ∪ B ∪ C := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem3_left A B C h
    · exact mem3_mid A B C h
  have hsubAC : A ∪ C ⊆ A ∪ B ∪ C := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem3_left A B C h
    · exact mem3_right A B C h
  have hsubBC : B ∪ C ⊆ A ∪ B ∪ C := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem3_mid A B C h
    · exact mem3_right A B C h
  have hsubA : A ⊆ A ∪ B ∪ C := fun _ h => mem3_left A B C h
  have hsubB : B ⊆ A ∪ B ∪ C := fun _ h => mem3_mid A B C h
  have hsubC : C ⊆ A ∪ B ∪ C := fun _ h => mem3_right A B C h
  have e1 := offDiag_sum_ind (A ∪ B ∪ C) (A ∪ B ∪ C) (Finset.Subset.refl _) b
  have e2 := offDiag_sum_ind (A ∪ B) (A ∪ B ∪ C) hsubAB b
  have e3 := offDiag_sum_ind (A ∪ C) (A ∪ B ∪ C) hsubAC b
  have e4 := offDiag_sum_ind (B ∪ C) (A ∪ B ∪ C) hsubBC b
  have e5 := offDiag_sum_ind A (A ∪ B ∪ C) hsubA b
  have e6 := offDiag_sum_ind B (A ∪ B ∪ C) hsubB b
  have e7 := offDiag_sum_ind C (A ∪ B ∪ C) hsubC b
  unfold sorkinI3
  simp only []
  rw [e1, e2, e3, e4, e5, e6, e7]
  rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_eq_zero fun p _ => ?_
  simp only [ind_union A B hAB, ind_union (A ∪ B) C hABC,
    ind_union A C hAC, ind_union B C hBC]
  ring

/-- The forward direction: a pairwise generated weight terminates at second
order, on every carrier and for every kernel. -/
theorem twoDecomposable_sorkinI3 (mu : Finset α → ℚ) (h : TwoDecomposable mu)
    (A B C : Finset α)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hBC : Disjoint B C) :
    sorkinI3 mu A B C = 0 := by
  obtain ⟨a, b, hmu⟩ := h
  rw [funext hmu, sorkinI3_add,
    sorkinI3_sum_singleton a A B C hAB hAC hBC,
    sorkinI3_sum_offDiag b A B C hAB hAC hBC]
  ring

theorem sorkinI4_sum_singleton (a : α → ℚ) (A B C D : Finset α)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hAD : Disjoint A D)
    (hBC : Disjoint B C) (hBD : Disjoint B D) (hCD : Disjoint C D) :
    sorkinI4 (fun S => ∑ i ∈ S, a i) A B C D = 0 := by
  have hAB_C : Disjoint (A ∪ B) C := Finset.disjoint_union_left.mpr ⟨hAC, hBC⟩
  have hAB_D : Disjoint (A ∪ B) D := Finset.disjoint_union_left.mpr ⟨hAD, hBD⟩
  have hAC_D : Disjoint (A ∪ C) D := Finset.disjoint_union_left.mpr ⟨hAD, hCD⟩
  have hBC_D : Disjoint (B ∪ C) D := Finset.disjoint_union_left.mpr ⟨hBD, hCD⟩
  have hABC_D : Disjoint (A ∪ B ∪ C) D :=
    Finset.disjoint_union_left.mpr ⟨hAB_D, hCD⟩
  simp only [sorkinI4, Finset.sum_union hAB_C, Finset.sum_union hAB_D,
    Finset.sum_union hAC_D, Finset.sum_union hBC_D, Finset.sum_union hABC_D,
    Finset.sum_union hAB, Finset.sum_union hAC, Finset.sum_union hAD,
    Finset.sum_union hBC, Finset.sum_union hBD, Finset.sum_union hCD]
  ring

theorem sorkinI4_sum_offDiag (b : α → α → ℚ) (A B C D : Finset α)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hAD : Disjoint A D)
    (hBC : Disjoint B C) (hBD : Disjoint B D) (hCD : Disjoint C D) :
    sorkinI4 (fun S => ∑ p ∈ S.offDiag, b p.1 p.2) A B C D = 0 := by
  classical
  have hAB_C : Disjoint (A ∪ B) C := Finset.disjoint_union_left.mpr ⟨hAC, hBC⟩
  have hAB_D : Disjoint (A ∪ B) D := Finset.disjoint_union_left.mpr ⟨hAD, hBD⟩
  have hAC_D : Disjoint (A ∪ C) D := Finset.disjoint_union_left.mpr ⟨hAD, hCD⟩
  have hBC_D : Disjoint (B ∪ C) D := Finset.disjoint_union_left.mpr ⟨hBD, hCD⟩
  have hABC_D : Disjoint (A ∪ B ∪ C) D :=
    Finset.disjoint_union_left.mpr ⟨hAB_D, hCD⟩
  have hsub1 : A ∪ B ∪ C ∪ D ⊆ A ∪ B ∪ C ∪ D := Finset.Subset.refl _
  have hsubABC : A ∪ B ∪ C ⊆ A ∪ B ∪ C ∪ D :=
    fun _ hx => Finset.mem_union_left _ hx
  have hsubABD : A ∪ B ∪ D ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · rcases Finset.mem_union.mp h with h' | h'
      · exact mem4_A A B C D h'
      · exact mem4_B A B C D h'
    · exact mem4_D A B C D h
  have hsubACD : A ∪ C ∪ D ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · rcases Finset.mem_union.mp h with h' | h'
      · exact mem4_A A B C D h'
      · exact mem4_C A B C D h'
    · exact mem4_D A B C D h
  have hsubBCD : B ∪ C ∪ D ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · rcases Finset.mem_union.mp h with h' | h'
      · exact mem4_B A B C D h'
      · exact mem4_C A B C D h'
    · exact mem4_D A B C D h
  have hsubA : A ⊆ A ∪ B ∪ C ∪ D := fun _ h => mem4_A A B C D h
  have hsubB : B ⊆ A ∪ B ∪ C ∪ D := fun _ h => mem4_B A B C D h
  have hsubC : C ⊆ A ∪ B ∪ C ∪ D := fun _ h => mem4_C A B C D h
  have hsubD : D ⊆ A ∪ B ∪ C ∪ D := fun _ h => mem4_D A B C D h
  have hsubAB : A ∪ B ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem4_A A B C D h
    · exact mem4_B A B C D h
  have hsubAC : A ∪ C ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem4_A A B C D h
    · exact mem4_C A B C D h
  have hsubAD : A ∪ D ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem4_A A B C D h
    · exact mem4_D A B C D h
  have hsubBC : B ∪ C ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem4_B A B C D h
    · exact mem4_C A B C D h
  have hsubBD : B ∪ D ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem4_B A B C D h
    · exact mem4_D A B C D h
  have hsubCD : C ∪ D ⊆ A ∪ B ∪ C ∪ D := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact mem4_C A B C D h
    · exact mem4_D A B C D h
  have e1 := offDiag_sum_ind (A ∪ B ∪ C ∪ D) (A ∪ B ∪ C ∪ D) hsub1 b
  have e2 := offDiag_sum_ind (A ∪ B ∪ C) (A ∪ B ∪ C ∪ D) hsubABC b
  have e3 := offDiag_sum_ind (A ∪ B ∪ D) (A ∪ B ∪ C ∪ D) hsubABD b
  have e4 := offDiag_sum_ind (A ∪ C ∪ D) (A ∪ B ∪ C ∪ D) hsubACD b
  have e5 := offDiag_sum_ind (B ∪ C ∪ D) (A ∪ B ∪ C ∪ D) hsubBCD b
  have e6 := offDiag_sum_ind (A ∪ B) (A ∪ B ∪ C ∪ D) hsubAB b
  have e7 := offDiag_sum_ind (A ∪ C) (A ∪ B ∪ C ∪ D) hsubAC b
  have e8 := offDiag_sum_ind (A ∪ D) (A ∪ B ∪ C ∪ D) hsubAD b
  have e9 := offDiag_sum_ind (B ∪ C) (A ∪ B ∪ C ∪ D) hsubBC b
  have e10 := offDiag_sum_ind (B ∪ D) (A ∪ B ∪ C ∪ D) hsubBD b
  have e11 := offDiag_sum_ind (C ∪ D) (A ∪ B ∪ C ∪ D) hsubCD b
  have e12 := offDiag_sum_ind A (A ∪ B ∪ C ∪ D) hsubA b
  have e13 := offDiag_sum_ind B (A ∪ B ∪ C ∪ D) hsubB b
  have e14 := offDiag_sum_ind C (A ∪ B ∪ C ∪ D) hsubC b
  have e15 := offDiag_sum_ind D (A ∪ B ∪ C ∪ D) hsubD b
  unfold sorkinI4
  simp only []
  rw [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15]
  rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib,
    ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib,
    ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_eq_zero fun p _ => ?_
  simp only [ind_union A B hAB, ind_union (A ∪ B) C hAB_C,
    ind_union (A ∪ B) D hAB_D, ind_union (A ∪ C) D hAC_D,
    ind_union (B ∪ C) D hBC_D, ind_union (A ∪ B ∪ C) D hABC_D,
    ind_union A C hAC, ind_union A D hAD,
    ind_union B C hBC, ind_union B D hBD, ind_union C D hCD]
  ring

/-- Second-order closure extends to the fourth-order term: pairwise
generation closes the next rung of the hierarchy as well. -/
theorem twoDecomposable_sorkinI4 (mu : Finset α → ℚ) (h : TwoDecomposable mu)
    (A B C D : Finset α)
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hAD : Disjoint A D)
    (hBC : Disjoint B C) (hBD : Disjoint B D) (hCD : Disjoint C D) :
    sorkinI4 mu A B C D = 0 := by
  obtain ⟨a, b, hmu⟩ := h
  rw [funext hmu]
  have h1 := sorkinI4_sum_singleton a A B C D hAB hAC hAD hBC hBD hCD
  have h2 := sorkinI4_sum_offDiag b A B C D hAB hAC hAD hBC hBD hCD
  have hsplit : sorkinI4
      (fun S : Finset α => (∑ i ∈ S, a i) + ∑ p ∈ S.offDiag, b p.1 p.2) A B C D
      = sorkinI4 (fun S => ∑ i ∈ S, a i) A B C D
        + sorkinI4 (fun S => ∑ p ∈ S.offDiag, b p.1 p.2) A B C D := by
    unfold sorkinI4
    ring
  rw [hsplit, h1, h2]
  ring

/--
The converse, on an arbitrary carrier: if the third-order term vanishes for
all pairwise disjoint nonempty triples, the weight is pairwise generated,
with the generating data read off the values on singletons and pairs.
-/
theorem vanishing_i3_is_two_decomposable (mu : Finset α → ℚ) (hempty : mu ∅ = 0)
    (h3 : ∀ A B C : Finset α, A.Nonempty → B.Nonempty → C.Nonempty →
      Disjoint A B → Disjoint A C → Disjoint B C → sorkinI3 mu A B C = 0) :
    TwoDecomposable mu := by
  classical
  set a : α → ℚ := fun i => mu {i} with ha
  set b : α → α → ℚ := fun i j => (mu {i, j} - mu {i} - mu {j}) / 2 with hb
  have hpair : ∀ i j : α, i ≠ j →
      ∑ p ∈ ({i, j} : Finset α).offDiag, b p.1 p.2
        = mu {i, j} - mu {i} - mu {j} := by
    intro i j hij
    rw [offDiag_pair i j hij]
    rw [Finset.sum_insert (by simp [Prod.mk.injEq, hij]),
      Finset.sum_insert (by simp)]
    have hcomm : ({j, i} : Finset α) = ({i, j} : Finset α) := by
      ext x
      simp only [Finset.mem_insert, Finset.mem_singleton]
      tauto
    simp only [hb, Finset.sum_empty]
    rw [hcomm]
    ring
  have main : ∀ (n : ℕ) (S : Finset α), S.card ≤ n →
      mu S = (∑ i ∈ S, a i) + ∑ p ∈ S.offDiag, b p.1 p.2 := by
    intro n
    induction n with
    | zero =>
      intro S hS
      obtain rfl : S = ∅ := Finset.card_eq_zero.mp (Nat.eq_zero_of_le_zero hS)
      rw [hempty, offDiag_empty]
      simp
    | succ m IHm =>
      intro S hS
      rcases Nat.lt_or_ge S.card (m + 1) with hlt | hge
      · exact IHm S (by omega)
      · have hcard : S.card = m + 1 := by omega
        rcases m with _ | _ | m''
        · obtain ⟨i, rfl⟩ := Finset.card_eq_one.mp (by omega)
          rw [offDiag_singleton]
          simp only [ha, Finset.sum_singleton, Finset.sum_empty]
          ring
        · obtain ⟨i, j, hij, rfl⟩ := Finset.card_eq_two.mp (by omega)
          rw [hpair i j hij]
          have e1 : ∑ k ∈ ({i, j} : Finset α), a k = a i + a j := by
            rw [Finset.sum_insert (by simp [hij]), Finset.sum_singleton]
          rw [e1]
          simp only [ha]
          ring
        · obtain ⟨x, hx⟩ : S.Nonempty := Finset.card_pos.mp (by omega)
          have hc1 : (S \ {x}).card = m'' + 2 := by
            rw [Finset.sdiff_singleton_eq_erase, Finset.card_erase_of_mem hx]
            omega
          obtain ⟨y, hy⟩ : (S \ {x}).Nonempty := Finset.card_pos.mp (by omega)
          have hxy : x ≠ y := by
            intro h
            exact (Finset.mem_sdiff.mp hy).2 (by simp [h])
          have hyS : y ∈ S := (Finset.mem_sdiff.mp hy).1
          set A : Finset α := {x} with hA
          set B : Finset α := {y} with hB
          set C : Finset α := S \ (A ∪ B) with hC
          have hAne : A.Nonempty := ⟨x, Finset.mem_singleton_self x⟩
          have hBne : B.Nonempty := ⟨y, Finset.mem_singleton_self y⟩
          have hdAB : Disjoint A B := by
            rw [hA, hB]
            exact Finset.disjoint_singleton.mpr hxy
          have hcardAB : (A ∪ B).card = 2 := by
            rw [Finset.card_union_of_disjoint hdAB, hA, hB]
            simp [Finset.card_singleton]
          have hABsub : A ∪ B ⊆ S :=
            Finset.union_subset (Finset.singleton_subset_iff.mpr hx)
              (Finset.singleton_subset_iff.mpr hyS)
          have hdAC : Disjoint A C := disjoint_intro A C (fun z hz1 hz2 => by
            have hz1x : z = x := Finset.mem_singleton.mp hz1
            have hzA : z ∈ A := by rw [hz1x, hA]; exact Finset.mem_singleton_self x
            rw [hC] at hz2
            exact (Finset.mem_sdiff.mp hz2).2 (Finset.mem_union_left _ hzA))
          have hdBC : Disjoint B C := disjoint_intro B C (fun z hz1 hz2 => by
            have hz1y : z = y := Finset.mem_singleton.mp hz1
            have hzB : z ∈ B := by rw [hz1y, hB]; exact Finset.mem_singleton_self y
            rw [hC] at hz2
            exact (Finset.mem_sdiff.mp hz2).2 (Finset.mem_union_right _ hzB))
          have hUnion : A ∪ B ∪ C = S := by
            ext z
            constructor
            · intro h
              rw [hC] at h
              rcases Finset.mem_union.mp h with h' | h'
              · exact hABsub h'
              · exact (Finset.mem_sdiff.mp h').1
            · intro hzS
              by_cases hzAB : z ∈ A ∪ B
              · exact Finset.mem_union_left _ hzAB
              · refine Finset.mem_union_right _ ?_
                rw [hC]
                exact Finset.mem_sdiff.mpr ⟨hzS, hzAB⟩
          have hdABC : Disjoint (A ∪ B) C :=
            Finset.disjoint_union_left.mpr ⟨hdAC, hdBC⟩
          have hcardC : C.card = m'' + 1 := by
            have hcardU : ((A ∪ B) ∪ C).card = (A ∪ B).card + C.card :=
              Finset.card_union_of_disjoint hdABC
            rw [hUnion, hcardAB] at hcardU
            omega
          have hCne : C.Nonempty := Finset.card_pos.mp (by omega)
          have hI3mu : sorkinI3 mu A B C = 0 :=
            h3 A B C hAne hBne hCne hdAB hdAC hdBC
          have hI3gen : sorkinI3
              (fun T => (∑ i ∈ T, a i) + ∑ p ∈ T.offDiag, b p.1 p.2) A B C = 0 :=
            twoDecomposable_sorkinI3 _
              ⟨a, b, fun _ => rfl⟩ A B C hdAB hdAC hdBC
          have hnu : sorkinI3
              (fun T => mu T - ((∑ i ∈ T, a i) + ∑ p ∈ T.offDiag, b p.1 p.2))
              A B C = 0 := by
            rw [sorkinI3_sub, hI3mu, hI3gen]
            ring
          unfold sorkinI3 at hnu
          simp only [] at hnu
          rw [hUnion] at hnu
          have hcardAC : (A ∪ C).card = m'' + 2 := by
            rw [Finset.card_union_of_disjoint hdAC, hcardC, hA,
              Finset.card_singleton]
            omega
          have hcardBC : (B ∪ C).card = m'' + 2 := by
            rw [Finset.card_union_of_disjoint hdBC, hcardC, hB,
              Finset.card_singleton]
            omega
          have eAB := IHm (A ∪ B) (by rw [hcardAB]; try omega)
          have eAC := IHm (A ∪ C) (by rw [hcardAC]; try omega)
          have eBC := IHm (B ∪ C) (by rw [hcardBC]; try omega)
          have eA := IHm A (by rw [hA, Finset.card_singleton]; try omega)
          have eB := IHm B (by rw [hB, Finset.card_singleton]; try omega)
          have eC := IHm C (by rw [hcardC]; try omega)
          rw [eAB, eAC, eBC, eA, eB, eC] at hnu
          linarith [hnu]
  exact ⟨a, b, fun S => main S.card S (Nat.le_refl S.card)⟩

/--
The main theorem: pairwise generation and vanishing third-order interference
are the same property of a weight, on every finite carrier.
-/
theorem pairwise_generation_iff_vanishing_third_order
    (mu : Finset α → ℚ) (hempty : mu ∅ = 0) :
    TwoDecomposable mu ↔
      ∀ A B C : Finset α, A.Nonempty → B.Nonempty → C.Nonempty →
        Disjoint A B → Disjoint A C → Disjoint B C → sorkinI3 mu A B C = 0 :=
  ⟨fun h A B C _ _ _ hAB hAC hBC =>
      twoDecomposable_sorkinI3 mu h A B C hAB hAC hBC,
    vanishing_i3_is_two_decomposable mu hempty⟩

theorem sum_eq_diag_plus_offDiag (f : α × α → ℚ) (S : Finset α) :
    ∑ p ∈ S ×ˢ S, f p = (∑ i ∈ S, f (i, i)) + ∑ p ∈ S.offDiag, f p := by
  classical
  have hdisj : Disjoint S.offDiag (S.image (fun i => (i, i))) :=
    disjoint_intro _ _ (fun p hp1 hp2 => by
      rw [Finset.mem_image] at hp2
      obtain ⟨i, _, rfl⟩ := hp2
      exact (Finset.mem_offDiag.mp hp1).2.2 rfl)
  have hEq : S ×ˢ S = S.offDiag ∪ S.image (fun i => (i, i)) := by
    ext p
    simp only [Finset.mem_product, Finset.mem_union, Finset.mem_offDiag,
      Finset.mem_image]
    constructor
    · rintro ⟨h1, h2⟩
      by_cases hne : p.1 = p.2
      · exact Or.inr ⟨p.2, h2, Prod.ext hne.symm rfl⟩
      · exact Or.inl ⟨h1, h2, hne⟩
    · rintro (⟨h1, h2, -⟩ | ⟨i, hi, rfl⟩)
      · exact ⟨h1, h2⟩
      · exact ⟨hi, hi⟩
  rw [hEq, Finset.sum_union hdisj,
    Finset.sum_image (fun a₁ _ a₂ _ h => (Prod.ext_iff.mp h).1)]
  ring

/--
The product of two additive (grade-one) weights is pairwise generated: the
observation of Guo-Cao-Chen-Yin (2011), as a corollary here.
-/
theorem product_of_additive_is_two_decomposable (f g : α → ℚ) :
    TwoDecomposable (fun S => (∑ i ∈ S, f i) * (∑ j ∈ S, g j)) := by
  refine ⟨fun i => f i * g i, fun i j => f i * g j, fun S => ?_⟩
  simp only []
  have hprod : ∑ i ∈ S, ∑ j ∈ S, f i * g j
      = ∑ p ∈ S ×ˢ S, f p.1 * g p.2 :=
    (Finset.sum_product S S (fun p => f p.1 * g p.2)).symm
  rw [Finset.sum_mul_sum, hprod, sum_eq_diag_plus_offDiag]
  try ring

inductive GradeIffFinding where
  | pairwiseGenerationIsEquivalentToVanishingThirdOrder
  | theEquivalenceHoldsOnEveryFiniteCarrier
  | pairwiseGenerationClosesTheFourthOrderToo
  | productOfAdditiveWeightsIsPairwiseGenerated
  deriving DecidableEq, Repr

def gradeIffFindings : List GradeIffFinding :=
  [ .pairwiseGenerationIsEquivalentToVanishingThirdOrder,
    .theEquivalenceHoldsOnEveryFiniteCarrier,
    .pairwiseGenerationClosesTheFourthOrderToo,
    .productOfAdditiveWeightsIsPairwiseGenerated ]

theorem grade_iff_records_four_findings :
    gradeIffFindings.length = 4 := by
  rfl

inductive GradeIffOpenObligation where
  | giveStableDistinguishabilitySemanticsSoTheEquivalenceReachesTheBase
  | stateCompositionClosureForcingBinarity
  | formalizeTheTwoSegalDecompositionReading
  | carryTheConverseBeyondQ
  deriving DecidableEq, Repr

def gradeIffOpenObligations : List GradeIffOpenObligation :=
  [ .giveStableDistinguishabilitySemanticsSoTheEquivalenceReachesTheBase,
    .stateCompositionClosureForcingBinarity,
    .formalizeTheTwoSegalDecompositionReading,
    .carryTheConverseBeyondQ ]

theorem grade_iff_keeps_four_open_obligations :
    gradeIffOpenObligations.length = 4 := by
  rfl

def gradeIffClaimBoundary : String :=
  "For set-function weights over ℚ with mu ∅ = 0 on an arbitrary finite carrier: the weight is generated by singleton and ordered-pair coefficients if and only if its Sorkin third-order term vanishes on all pairwise disjoint nonempty triples, and such weights also have vanishing fourth-order term. The product of two additive weights is pairwise generated. This is a characterization of a class of readouts. It does not give the primitive base any semantics, does not derive complex amplitudes or a Hilbert carrier, does not derive the Born rule, and does not show that stable distinguishability is such a weight."

end QMClosure
