import Proofs.QMClosure.TransparentPositivePowerRejoin
import Mathlib.Analysis.Complex.Norm
import Mathlib.Analysis.Normed.Group.Continuity
import Mathlib.Topology.Instances.NNReal.Lemmas
import Mathlib.Algebra.Ring.Prod
import Mathlib.Tactic

/-!
# A continuous cubic-rejoin readout countermodel

The carrier is the subsemiring of `ℂ × ℝ≥0` generated by two transparent
branches. Its second coordinate reflects algebraic zero. The response is the
product of complex norm and second coordinate, and is continuous and globally
multiplicative on the entire generated carrier.

The response satisfies a literal four-law base, exact serial preservation,
natural square gain, stationary tripler gain nine, conjugation invariance,
self-square, and self-echo. The branches have an equal cubic rejoin and an
equal sixth rejoin, while their fourth powers differ.

An explicit triple of depth-two words has third inclusion-exclusion value
`-3/4`. The triple uses the distinct word labels `aa`, `ab`, and `bb` from the
four binary words at depth two. No physical slit implementation is supplied.

Older eighth-rejoin controls already establish a generic carrier-selection
wall, and some satisfy additional prepared mixed-zero laws. This construction
combines continuity with global multiplicativity on this generated cubic
carrier and a short third inclusion-exclusion witness. Two-generated positive
carriers already occur in the earlier eighth-rejoin work.
It supplies generic finite-rejoin rules. The P4-specific dyadic normal form
and physical-origin claims remain outside its conclusion.
-/

noncomputable section

namespace IDT.QMClosure.CubicRejoinReadoutCountermodel

open scoped ComplexConjugate NNReal

abbrev Ambient := ℂ × ℝ≥0

def r : ℝ := Real.sqrt 3

theorem r_sq : r ^ 2 = 3 := Real.sq_sqrt (by norm_num)

theorem r_pos : 0 < r := Real.sqrt_pos.2 (by norm_num)

def zeta : ℂ := ⟨1 / 2, r / 2⟩

theorem zeta_sum : zeta + conj zeta = 1 := by
  apply Complex.ext <;> simp [zeta]
  ring

theorem zeta_product : zeta * conj zeta = 1 := by
  apply Complex.ext <;> simp [zeta, Complex.mul_re, Complex.mul_im] <;> nlinarith [r_sq]

theorem zeta_sq : zeta ^ 2 = zeta - 1 := by
  linear_combination zeta * zeta_sum - zeta_product

theorem zeta_cube : zeta ^ 3 = -1 := by
  linear_combination (zeta + 1) * zeta_sq

theorem conj_zeta_cube : conj zeta ^ 3 = -1 := by
  simpa using congrArg (fun z : ℂ => conj z) zeta_cube

theorem zeta_sq_sum : zeta ^ 2 + conj zeta ^ 2 = -1 := by
  calc
    zeta ^ 2 + conj zeta ^ 2 =
        (zeta + conj zeta) ^ 2 - 2 * (zeta * conj zeta) := by ring
    _ = -1 := by rw [zeta_sum, zeta_product]; norm_num

theorem zeta_normSq : Complex.normSq zeta = 1 := by
  simp [Complex.normSq_apply, zeta]
  nlinarith [r_sq]

theorem zeta_norm : ‖zeta‖ = 1 := by
  have hsq := Complex.sq_norm zeta
  rw [zeta_normSq] at hsq
  nlinarith [norm_nonneg zeta]

def a0 : Ambient := (zeta, 1 / 2)

def b0 : Ambient := (conj zeta, 1 / 2)

def generated : Subsemiring Ambient := Subsemiring.closure {a0, b0}

abbrev Carrier := ↥generated

def a : Carrier := ⟨a0, Subsemiring.subset_closure (by simp)⟩

def b : Carrier := ⟨b0, Subsemiring.subset_closure (by simp)⟩

def E : Carrier →+* ℂ := (RingHom.fst ℂ ℝ≥0).comp generated.subtype

def Q : Carrier →+* ℝ≥0 := (RingHom.snd ℂ ℝ≥0).comp generated.subtype

@[simp] theorem E_a : E a = zeta := rfl

@[simp] theorem E_b : E b = conj zeta := rfl

@[simp] theorem Q_a : Q a = 1 / 2 := rfl

@[simp] theorem Q_b : Q b = 1 / 2 := rfl

theorem carrier_ext {p q : Carrier} (hE : E p = E q) (hQ : Q p = Q q) : p = q := by
  apply Subtype.ext
  exact Prod.ext hE hQ

/-- Positivity of the generated carrier's second coordinate reflects zero. -/
theorem ambient_second_zero_reflection {p : Ambient} (hp : p ∈ generated) :
    p.2 = 0 → p = 0 := by
  change p ∈ Subsemiring.closure {a0, b0} at hp
  refine Subsemiring.closure_induction
    (p := fun x _ => x.2 = 0 → x = 0) ?_ ?_ ?_ ?_ ?_ hp
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl <;> norm_num [a0, b0]
  · intro _
    rfl
  · intro h
    have h' : (1 : ℝ≥0) = 0 := h
    norm_num at h'
  · intro x y _ _ hx hy h
    have hx0 : x.2 = 0 := by
      apply le_antisymm _ (zero_le _)
      calc
        x.2 ≤ x.2 + y.2 := le_add_of_nonneg_right (zero_le _)
        _ = 0 := h
    have hy0 : y.2 = 0 := by
      apply le_antisymm _ (zero_le _)
      calc
        y.2 ≤ x.2 + y.2 := le_add_of_nonneg_left (zero_le _)
        _ = 0 := h
    rw [hx hx0, hy hy0, zero_add]
  · intro x y _ _ hx hy h
    have hxy : x.2 * y.2 = 0 := h
    rcases mul_eq_zero.mp hxy with hx0 | hy0
    · rw [hx hx0, zero_mul]
    · rw [hy hy0, mul_zero]

theorem Q_zero_reflection {p : Carrier} (h : Q p = 0) : p = 0 := by
  apply Subtype.ext
  exact ambient_second_zero_reflection p.property h

theorem Q_zero_iff (p : Carrier) : Q p = 0 ↔ p = 0 := by
  exact ⟨Q_zero_reflection, fun h => by simp [h]⟩

theorem Q_pos {p : Carrier} (hp : p ≠ 0) : 0 < Q p := by
  exact lt_of_le_of_ne (zero_le _) (Ne.symm (fun h => hp (Q_zero_reflection h)))

instance carrierNoZeroDivisors : NoZeroDivisors Carrier where
  eq_zero_or_eq_zero_of_mul_eq_zero := by
    intro p q h
    have hQ : Q p * Q q = 0 := by rw [← map_mul, h, map_zero]
    exact (mul_eq_zero.mp hQ).imp Q_zero_reflection Q_zero_reflection

/-- Algebraic zero-sum reflection excludes nonzero additive inverses. -/
theorem zero_sum_reflection {p q : Carrier} (h : p + q = 0) : p = 0 ∧ q = 0 := by
  have hQ : Q p + Q q = 0 := by rw [← map_add, h, map_zero]
  constructor
  · apply Q_zero_reflection
    apply le_antisymm _ (zero_le _)
    calc
      Q p ≤ Q p + Q q := le_add_of_nonneg_right (zero_le _)
      _ = 0 := hQ
  · apply Q_zero_reflection
    apply le_antisymm _ (zero_le _)
    calc
      Q q ≤ Q p + Q q := le_add_of_nonneg_left (zero_le _)
      _ = 0 := hQ

def ambientJ : Ambient →+* Ambient :=
  (starRingEnd ℂ).prodMap (RingHom.id ℝ≥0)

theorem ambientJ_a0 : ambientJ a0 = b0 := rfl

theorem ambientJ_b0 : ambientJ b0 = a0 := by
  change (conj (conj zeta), (1 / 2 : ℝ≥0)) = (zeta, 1 / 2)
  simp

theorem ambientJ_mem {p : Ambient} (hp : p ∈ generated) : ambientJ p ∈ generated := by
  change p ∈ Subsemiring.closure {a0, b0} at hp
  refine Subsemiring.closure_induction
    (p := fun x _ => ambientJ x ∈ generated) ?_ ?_ ?_ ?_ ?_ hp
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · rw [ambientJ_a0]
      exact b.property
    · rw [ambientJ_b0]
      exact a.property
  · simpa only [map_zero] using generated.zero_mem
  · simpa only [map_one] using generated.one_mem
  · intro x y _ _ hx hy
    rw [map_add]
    exact generated.add_mem hx hy
  · intro x y _ _ hx hy
    rw [map_mul]
    exact generated.mul_mem hx hy

def J : Carrier →+* Carrier where
  toFun p := ⟨ambientJ p.val, ambientJ_mem p.property⟩
  map_zero' := Subtype.ext (map_zero ambientJ)
  map_one' := Subtype.ext (map_one ambientJ)
  map_add' p q := Subtype.ext (map_add ambientJ p.val q.val)
  map_mul' p q := Subtype.ext (map_mul ambientJ p.val q.val)

@[simp] theorem E_J (p : Carrier) : E (J p) = conj (E p) := rfl

@[simp] theorem Q_J (p : Carrier) : Q (J p) = Q p := rfl

theorem J_involutive (p : Carrier) : J (J p) = p := by
  apply carrier_ext <;> simp

theorem J_a : J a = b := by
  apply carrier_ext <;> simp

theorem J_b : J b = a := by
  apply carrier_ext <;> simp

theorem transparent : a + b = 1 := by
  apply carrier_ext
  · simpa using zeta_sum
  · norm_num

theorem cubic_rejoin : a ^ 3 = b ^ 3 := by
  apply carrier_ext
  · simp [zeta_cube, conj_zeta_cube]
  · simp

theorem sixth_rejoin : a ^ 6 = b ^ 6 := by
  calc
    a ^ 6 = (a ^ 3) ^ 2 := by ring
    _ = (b ^ 3) ^ 2 := by rw [cubic_rejoin]
    _ = b ^ 6 := by ring

theorem fourth_rejoin_false : a ^ 4 ≠ b ^ 4 := by
  intro h
  have hz : zeta ^ 4 = conj zeta ^ 4 := by
    simpa only [map_pow, E_a, E_b] using congrArg E h
  have ha : zeta ^ 4 = -zeta := by rw [show 4 = 3 + 1 by decide, pow_succ, zeta_cube]; ring
  have hb : conj zeta ^ 4 = -conj zeta := by
    rw [show 4 = 3 + 1 by decide, pow_succ, conj_zeta_cube]
    ring
  rw [ha, hb] at hz
  have him := congrArg Complex.im hz
  simp [zeta] at him
  linarith [r_pos]

/-- The inverse word contains only addition, multiplication, and natural powers. -/
def aInv : Carrier := 1 + b + b ^ 2 + a ^ 2

def bInv : Carrier := 1 + a + a ^ 2 + b ^ 2

theorem a_inverse : aInv * a = 1 ∧ a * aInv = 1 := by
  simpa [aInv, IDT.TransparentPositivePowerRejoin.inverseWordA,
    Finset.sum_range_succ, add_assoc] using
    IDT.TransparentPositivePowerRejoin.geometric_inverse_a 2 2 transparent cubic_rejoin

theorem b_inverse : bInv * b = 1 ∧ b * bInv = 1 := by
  simpa [bInv, IDT.TransparentPositivePowerRejoin.inverseWordB,
    Finset.sum_range_succ, add_assoc] using
    IDT.TransparentPositivePowerRejoin.geometric_inverse_b 2 2 transparent cubic_rejoin

def rho : Carrier := a * bInv

theorem rho_period_three : rho ^ 3 = 1 := by
  rw [rho, mul_pow, cubic_rejoin, ← mul_pow, b_inverse.2, one_pow]

def ambientW (p : Ambient) : ℝ := ‖p.1‖ * (p.2 : ℝ)

def W (p : Carrier) : ℝ := ‖E p‖ * (Q p : ℝ)

theorem ambientW_continuous : Continuous ambientW := by
  exact continuous_fst.norm.mul (NNReal.continuous_coe.comp continuous_snd)

theorem W_continuous : Continuous W := by
  change Continuous (fun p : Carrier => ambientW (p : Ambient))
  exact ambientW_continuous.comp continuous_subtype_val

theorem ambientW_multiplicative (p q : Ambient) :
    ambientW (p * q) = ambientW p * ambientW q := by
  change ‖p.1 * q.1‖ * ((p.2 * q.2 : ℝ≥0) : ℝ) =
    (‖p.1‖ * (p.2 : ℝ)) * (‖q.1‖ * (q.2 : ℝ))
  rw [norm_mul, NNReal.coe_mul]
  ring

@[simp] theorem W_zero : W 0 = 0 := by simp [W]

@[simp] theorem W_one : W 1 = 1 := by simp [W]

theorem W_nonnegative (p : Carrier) : 0 ≤ W p :=
  mul_nonneg (norm_nonneg _) (Q p).property

theorem W_multiplicative (p q : Carrier) : W (p * q) = W p * W q := by
  simp only [W, map_mul, norm_mul, NNReal.coe_mul]
  ring

theorem W_swap (p : Carrier) : W (J p) = W p := by
  simp [W]

theorem W_self_square (p : Carrier) : W (p ^ 2) = W p ^ 2 := by
  rw [pow_two, W_multiplicative, pow_two]

theorem W_self_echo (p : Carrier) : W (p * J p) = W p ^ 2 := by
  rw [W_multiplicative, W_swap, pow_two]

@[simp] theorem W_a : W a = 1 / 2 := by simp [W, zeta_norm]

@[simp] theorem W_b : W b = 1 / 2 := by simp [W, zeta_norm]

theorem W_global_halves (p : Carrier) :
    W (a * p) = W p / 2 ∧ W (b * p) = W p / 2 := by
  rw [W_multiplicative, W_multiplicative, W_a, W_b]
  constructor <;> ring

theorem W_first_column (p : Carrier) : W (a * p) + W (b * p) = W p := by
  rw [(W_global_halves p).1, (W_global_halves p).2]
  ring

def c : Carrier := (2 : Carrier) * (a * b)

theorem E_c : E c = 2 := by simp [c, zeta_product, map_ofNat]

theorem Q_c : Q c = 1 / 2 := by norm_num [c, map_ofNat]

theorem W_c : W c = 1 := by norm_num [W, E_c, Q_c]

theorem W_exact_serial (p : Carrier) : W (c * p) = W p := by
  rw [W_multiplicative, W_c, one_mul]

theorem W_serial_increasing (p : Carrier) : W p ≤ W (c * p) := by
  rw [W_exact_serial]

theorem W_nat (n : ℕ) : W (n : Carrier) = (n : ℝ) ^ 2 := by
  simp [W, pow_two]

theorem W_natural_gain (n : ℕ) (p : Carrier) :
    W ((n : Carrier) * p) = (n : ℝ) ^ 2 * W p := by
  rw [W_multiplicative, W_nat]

theorem W_tripler (p : Carrier) : W ((3 : Carrier) * p) = 9 * W p := by
  simpa only [Nat.cast_ofNat, show (3 : ℝ) ^ 2 = 9 by norm_num] using W_natural_gain 3 p

theorem W_stationary_tripler (p : Carrier) :
    W ((3 : Carrier) * p) = W (3 : Carrier) * W p := W_multiplicative _ _

def B (n m : ℕ) : Carrier := (n : Carrier) * a + (m : Carrier) * b

/-- The squared prepared response has nonnegative polynomial coefficients. -/
def quartic (n m : ℕ) : ℝ :=
  ((n : ℝ) ^ 4 + (n : ℝ) ^ 3 * m + (n : ℝ) * (m : ℝ) ^ 3 + (m : ℝ) ^ 4) / 4

theorem E_B_normSq (n m : ℕ) :
    Complex.normSq (E (B n m)) = (n : ℝ) ^ 2 - (n : ℝ) * m + (m : ℝ) ^ 2 := by
  simp only [B, map_add, map_mul, map_natCast, E_a, E_b]
  simp [Complex.normSq_apply, zeta, Complex.mul_re, Complex.mul_im]
  ring_nf
  simp only [r_sq]
  ring

theorem Q_B (n m : ℕ) : (Q (B n m) : ℝ) = ((n : ℝ) + m) / 2 := by
  simp [B]
  ring

theorem W_B_sq (n m : ℕ) : W (B n m) ^ 2 = quartic n m := by
  rw [W, mul_pow, Complex.sq_norm, E_B_normSq, Q_B]
  dsimp [quartic]
  ring

theorem quartic_mono {n m n' m' : ℕ} (hn : n ≤ n') (hm : m ≤ m') :
    quartic n m ≤ quartic n' m' := by
  have hnr : (n : ℝ) ≤ n' := by exact_mod_cast hn
  have hmr : (m : ℝ) ≤ m' := by exact_mod_cast hm
  dsimp [quartic]
  gcongr

theorem W_B_mono {n m n' m' : ℕ} (hn : n ≤ n') (hm : m ≤ m') :
    W (B n m) ≤ W (B n' m') := by
  have hsq : W (B n m) ^ 2 ≤ W (B n' m') ^ 2 := by
    rw [W_B_sq, W_B_sq]
    exact quartic_mono hn hm
  nlinarith [W_nonnegative (B n m), W_nonnegative (B n' m')]

theorem W_prepared_count_order (p : Carrier) (n m n' m' : ℕ)
    (hn : n ≤ n') (hm : m ≤ m') : W (B n m * p) ≤ W (B n' m' * p) := by
  rw [W_multiplicative, W_multiplicative]
  exact mul_le_mul_of_nonneg_right (W_B_mono hn hm) (W_nonnegative p)

/-- The four fields are stated on this generated carrier. -/
structure BaseContract (R : Carrier → ℝ) : Prop where
  normalized : R 1 = 1
  column : ∀ p, R (a * p) + R (b * p) = R p
  cIncreasing : ∀ p, R p ≤ R (c * p)
  preparedOrder : ∀ (p : Carrier) (n m n' m' : ℕ), n ≤ n' → m ≤ m' →
    R (B n m * p) ≤ R (B n' m' * p)

theorem W_base_contract : BaseContract W where
  normalized := W_one
  column := W_first_column
  cIncreasing := W_serial_increasing
  preparedOrder := W_prepared_count_order

def x : Carrier := a ^ 2

def y : Carrier := a * b

def z : Carrier := b ^ 2

def t : Carrier := x + y + z

theorem x_add_y : x + y = a := by
  calc
    x + y = a * (a + b) := by dsimp [x, y]; ring
    _ = a := by rw [transparent, mul_one]

theorem y_add_z : y + z = b := by
  calc
    y + z = (a + b) * b := by dsimp [y, z]; ring
    _ = b := by rw [transparent, one_mul]

theorem E_x_add_z : E (x + z) = -1 := by
  simpa [x, z] using zeta_sq_sum

theorem Q_x_add_z : Q (x + z) = 1 / 2 := by norm_num [x, z]

theorem E_t : E t = 0 := by
  simp only [t, x, y, z, map_add, map_pow, map_mul, E_a, E_b, zeta_product]
  linear_combination zeta_sq_sum

theorem Q_t : Q t = 3 / 4 := by norm_num [t, x, y, z]

theorem t_nonzero : t ≠ 0 := by
  intro h
  have hQ := congrArg Q h
  rw [Q_t, map_zero] at hQ
  norm_num at hQ

theorem W_x : W x = 1 / 4 := by
  rw [x, W_self_square, W_a]
  norm_num

theorem W_y : W y = 1 / 4 := by
  rw [y, W_multiplicative, W_a, W_b]
  norm_num

theorem W_z : W z = 1 / 4 := by
  rw [z, W_self_square, W_b]
  norm_num

theorem W_x_add_y : W (x + y) = 1 / 2 := by rw [x_add_y, W_a]

theorem W_y_add_z : W (y + z) = 1 / 2 := by rw [y_add_z, W_b]

theorem W_x_add_z : W (x + z) = 1 / 2 := by
  norm_num [W, E_x_add_z, Q_x_add_z]

theorem W_t : W t = 0 := by simp [W, E_t]

theorem x_y_z_distinct : x ≠ y ∧ x ≠ z ∧ y ≠ z := by
  have himx : (E x).im = r / 2 := by
    simp [x, pow_two, zeta, Complex.mul_im]
    ring
  have himy : (E y).im = 0 := by simp [y, zeta_product]
  have himz : (E z).im = -r / 2 := by
    simp [z, pow_two, zeta, Complex.mul_im]
    ring
  refine ⟨?_, ?_, ?_⟩ <;> intro h
  · have hh := congrArg (fun p : Carrier => (E p).im) h
    change (E x).im = (E y).im at hh
    rw [himx, himy] at hh
    linarith [r_pos]
  · have hh := congrArg (fun p : Carrier => (E p).im) h
    change (E x).im = (E z).im at hh
    rw [himx, himz] at hh
    linarith [r_pos]
  · have hh := congrArg (fun p : Carrier => (E p).im) h
    change (E y).im = (E z).im at hh
    rw [himy, himz] at hh
    linarith [r_pos]

/-- Third inclusion-exclusion on three algebraic depth-two word labels. -/
def I3 (u v w : Carrier) : ℝ :=
  W (u + v + w) - W (u + v) - W (u + w) - W (v + w) + W u + W v + W w - W 0

theorem I3_witness : I3 x y z = -3 / 4 := by
  change W t - W (x + y) - W (x + z) - W (y + z) + W x + W y + W z - W 0 = -3 / 4
  rw [W_t, W_x_add_y, W_x_add_z, W_y_add_z, W_x, W_y, W_z, W_zero]
  norm_num

theorem t_add_y : t + y = 1 := by
  calc
    t + y = (a + b) ^ 2 := by dsimp [t, x, y, z]; ring
    _ = 1 := by rw [transparent, one_pow]

theorem W_t_add_y : W (t + y) = 1 := by rw [t_add_y, W_one]

theorem null_insertion_failure : W t = 0 ∧ W (t + y) ≠ W y := by
  refine ⟨W_t, ?_⟩
  rw [W_t_add_y, W_y]
  norm_num

theorem W_one_add_t : W (1 + t) = 7 / 4 := by
  norm_num [W, E_t, Q_t]

/-- Zero reflection of `Q` is compatible with a nonzero response-dark element. -/
theorem W_zero_iff_E_zero (p : Carrier) : W p = 0 ↔ E p = 0 := by
  constructor
  · intro h
    by_cases hp : p = 0
    · simp [hp]
    · have hQ : (Q p : ℝ) ≠ 0 := by
        exact_mod_cast ne_of_gt (Q_pos hp)
      dsimp [W] at h
      rcases mul_eq_zero.mp h with hnorm | hzero
      · exact norm_eq_zero.mp hnorm
      · exact (hQ hzero).elim
  · intro h
    simp [W, h]

theorem W_null_additive {p q : Carrier} (hp : W p = 0) (hq : W q = 0) :
    W (p + q) = 0 := by
  apply (W_zero_iff_E_zero _).2
  rw [map_add, (W_zero_iff_E_zero _).1 hp, (W_zero_iff_E_zero _).1 hq, add_zero]

theorem W_zero_product_separation {p q : Carrier} (h : W (p * q) = 0) :
    W p = 0 ∨ W q = 0 := by
  rw [W_multiplicative] at h
  exact mul_eq_zero.mp h

theorem W_not_factors_through_E : ¬ ∃ F : ℂ → ℝ, ∀ p, W p = F (E p) := by
  rintro ⟨F, hF⟩
  have hc := hF c
  have htwo := hF ((2 : ℕ) : Carrier)
  rw [W_c, E_c] at hc
  rw [W_nat, map_natCast] at htwo
  norm_num at htwo
  linarith

/-- The full response laws quantify over every element of the generated carrier. -/
theorem continuous_countermodel_certificate :
    BaseContract W ∧ Continuous W ∧
    (∀ p q, W (p * q) = W p * W q) ∧
    (∀ p, W (c * p) = W p) ∧
    (∀ (n : ℕ) p, W ((n : Carrier) * p) = (n : ℝ) ^ 2 * W p) ∧
    (∀ p, W ((3 : Carrier) * p) = 9 * W p) ∧
    (∀ p, W (J p) = W p) ∧
    (∀ p, W (p ^ 2) = W p ^ 2) ∧
    (∀ p, W (p * J p) = W p ^ 2) ∧
    a + b = 1 ∧ a ^ 3 = b ^ 3 ∧ a ^ 6 = b ^ 6 ∧ a ^ 4 ≠ b ^ 4 ∧
    t ≠ 0 ∧ W t = 0 ∧ I3 x y z = -3 / 4 ∧ W (t + y) ≠ W y := by
  exact ⟨W_base_contract, W_continuous, W_multiplicative, W_exact_serial,
    W_natural_gain, W_tripler, W_swap, W_self_square, W_self_echo,
    transparent, cubic_rejoin, sixth_rejoin, fourth_rejoin_false,
    t_nonzero, W_t, I3_witness, null_insertion_failure.2⟩

end IDT.QMClosure.CubicRejoinReadoutCountermodel

end
