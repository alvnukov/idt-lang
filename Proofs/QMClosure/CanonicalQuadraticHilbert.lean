import Proofs.QMClosure.QuadraticHermitianKernel
import Mathlib.Analysis.InnerProductSpace.Completion
import Mathlib.Topology.Algebra.Order.Archimedean

namespace IDT.QMClosure.CanonicalQuadraticHilbert

open QuadraticRecordRefinement PositiveQuadraticPolarization
open QuadraticHermitianKernel
open scoped ComplexOrder

noncomputable section

/-!
The complex scalars and topology below belong to a constructed auxiliary space,
not to the input carrier. Completion identifies zero seminorm differences.
No physical availability, event actualization, dynamics, tensor product, or
physical scale follows from this mathematical construction.
-/

variable {V : Type*} [AddCommGroup V] {Q : V → ℝ}

set_option linter.unusedVariables false in
/-- The free complex module, indexed by the data defining its seminorm. -/
def Free (h : PositiveQuadratic Q) (phase : QuadraticPhase Q) := V →₀ ℂ

variable (h : PositiveQuadratic Q) (phase : QuadraticPhase Q)

instance : AddCommGroup (Free h phase) := inferInstanceAs (AddCommGroup (V →₀ ℂ))
instance : Module ℂ (Free h phase) := inferInstanceAs (Module ℂ (V →₀ ℂ))

private def freeInner (f g : Free h phase) : ℂ :=
  (f : V →₀ ℂ).sum fun x a => (g : V →₀ ℂ).sum fun y b =>
    star a * kernel phase x y * b

instance : PreInnerProductSpace.Core ℂ (Free h phase) where
  inner := freeInner h phase
  conj_inner_symm f g := by
    change (starRingEnd ℂ) (freeInner h phase g f) = freeInner h phase f g
    unfold freeInner
    rw [Finsupp.sum_comm]
    simp only [map_finsuppSum]
    congr! 4
    funext y b
    change star (star b * kernel phase y _ * _) = _
    rw [star_mul, star_mul, star_star, hermitian h phase]
    ring
  re_inner_nonneg f := by
    exact (Complex.nonneg_iff.mp ((posSemidef h phase).2 (f : V →₀ ℂ))).1
  add_left f g k := by
    unfold freeInner
    refine Finsupp.sum_add_index' ?_ ?_
    · simp
    · intro x a b
      simp [← Finsupp.sum_add, add_mul]
  smul_left f g c := by
    change freeInner h phase (c • (f : V →₀ ℂ)) g = _
    unfold freeInner
    calc
      _ = (f : V →₀ ℂ).sum (fun x a =>
          (g : V →₀ ℂ).sum fun y b => star (c * a) * kernel phase x y * b) :=
        Finsupp.sum_smul_index (by simp)
      _ = _ := by simp [star_mul, Finsupp.mul_sum, mul_assoc, mul_left_comm]

instance : SeminormedAddCommGroup (Free h phase) :=
  InnerProductSpace.Core.toSeminormedAddCommGroup (𝕜 := ℂ)

instance : InnerProductSpace ℂ (Free h phase) := .ofCore _

/-- The separated complete complex inner product space generated by the kernel. -/
abbrev Hilbert := UniformSpace.Completion (Free h phase)

/-- A carrier element gives a free basis vector, then its completion class. -/
def feature (x : V) : Hilbert h phase :=
  UniformSpace.Completion.coe' (α := Free h phase) (Finsupp.single x (1 : ℂ))

theorem inner_feature (x y : V) :
    inner ℂ (feature h phase x) (feature h phase y) = kernel phase x y := by
  classical
  simp only [feature, UniformSpace.Completion.inner_coe]
  change freeInner h phase (Finsupp.single x 1) (Finsupp.single y 1) = _
  simp [freeInner]

theorem norm_feature_sq (x : V) : ‖feature h phase x‖ ^ 2 = Q x := by
  rw [norm_sq_eq_re_inner (𝕜 := ℂ), inner_feature,
    QuadraticHermitianKernel.diagonal h phase]
  simp

theorem feature_add (x y : V) :
    feature h phase (x + y) = feature h phase x + feature h phase y := by
  classical
  refine UniformSpace.Completion.denseRange_coe.eq_of_inner_left ℂ fun f => ?_
  simp only [inner_add_left, feature, UniformSpace.Completion.inner_coe]
  change freeInner h phase (Finsupp.single (x + y) 1) f =
    freeInner h phase (Finsupp.single x 1) f + freeInner h phase (Finsupp.single y 1) f
  simp [freeInner, QuadraticHermitianKernel.add_left h phase,
    add_mul, Finsupp.sum_add]

theorem feature_zero : feature h phase 0 = 0 := by
  have he := feature_add h phase 0 0
  have he' : feature h phase 0 + 0 = feature h phase 0 + feature h phase 0 := by
    simpa only [zero_add, add_zero] using he
  exact (add_left_cancel he').symm

/-- Additivity holds after the null quotient, not among free basis vectors. -/
def featureHom : V →+ Hilbert h phase where
  toFun := feature h phase
  map_zero' := feature_zero h phase
  map_add' := feature_add h phase

theorem feature_phase (x : V) :
    feature h phase (phase.J x) = Complex.I • feature h phase x := by
  classical
  refine UniformSpace.Completion.denseRange_coe.eq_of_inner_left ℂ fun f => ?_
  simp only [inner_smul_left, feature, UniformSpace.Completion.inner_coe]
  change freeInner h phase (Finsupp.single (phase.J x) 1) f =
    star Complex.I * freeInner h phase (Finsupp.single x 1) f
  simp [freeInner, phase_left h phase, Finsupp.mul_sum, ← mul_assoc]

theorem feature_eq_iff (x y : V) :
    feature h phase x = feature h phase y ↔ Q (x - y) = 0 := by
  change featureHom h phase x = featureHom h phase y ↔ _
  rw [← sub_eq_zero, ← map_sub]
  change feature h phase (x - y) = 0 ↔ _
  rw [← norm_eq_zero, ← sq_eq_zero_iff, norm_feature_sq]

theorem feature_eq_iff_all_reference_tests (x y : V) :
    feature h phase x = feature h phase y ↔ ∀ z, Q (x + z) = Q (y + z) := by
  rw [feature_eq_iff, null_iff_all_reference_tests h]

/-- The complex linear span is dense without divisibility on the carrier. -/
theorem dense_span_feature :
    Dense (Submodule.span ℂ (Set.range (feature h phase)) : Set (Hilbert h phase)) := by
  classical
  let S := Submodule.span ℂ (Set.range (feature h phase))
  have hs (x : V) (a : ℂ) :
      UniformSpace.Completion.coe' (α := Free h phase) (Finsupp.single x a) ∈ S := by
    have he : UniformSpace.Completion.coe' (α := Free h phase) (Finsupp.single x a) =
        a • feature h phase x := by
      have he := UniformSpace.Completion.coe_smul (X := Free h phase) a
        (Finsupp.single x (1 : ℂ))
      have hm : a • (Finsupp.single x (1 : ℂ) : Free h phase) = Finsupp.single x a :=
        (Finsupp.smul_single a x (1 : ℂ)).trans (by simp)
      exact (congrArg (UniformSpace.Completion.coe' (α := Free h phase)) hm).symm.trans he
    rw [he]
    exact S.smul_mem a (Submodule.subset_span (Set.mem_range_self x))
  apply UniformSpace.Completion.denseRange_coe.mono
  rintro _ ⟨f, rfl⟩
  change (f : Hilbert h phase) ∈ S
  induction f using Finsupp.induction with
  | zero =>
      exact (UniformSpace.Completion.coe_zero (α := Free h phase)).symm ▸ S.zero_mem
  | single_add x a f _ _ ih =>
      exact (UniformSpace.Completion.coe_add (α := Free h phase)
        (Finsupp.single x a) f).symm ▸ S.add_mem (hs x a) ih

/-- A genuine operational half gives scalar halving in the constructed space. -/
theorem feature_half (half : V →+ V) (halves : ∀ x, half x + half x = x) (x : V) :
    feature h phase (half x) = (2 : ℂ)⁻¹ • feature h phase x := by
  have he : (2 : ℂ) • feature h phase (half x) = feature h phase x := by
    rw [two_smul, ← feature_add, halves]
  rw [← he, smul_smul]
  norm_num

private theorem closed_subgroup_complex_smul
    (T : AddSubgroup (Hilbert h phase)) (closed : IsClosed (T : Set (Hilbert h phase)))
    (halve : ∀ u ∈ T, (2 : ℂ)⁻¹ • u ∈ T)
    (quarter : ∀ u ∈ T, Complex.I • u ∈ T)
    (c : ℂ) (u : Hilbert h phase) (hu : u ∈ T) : c • u ∈ T := by
  have real_mem (r : ℝ) (v : Hilbert h phase) (hv : v ∈ T) : (r : ℂ) • v ∈ T := by
    let S : AddSubgroup ℝ := {
      carrier := {r | (r : ℂ) • v ∈ T}
      zero_mem' := by simp
      add_mem' := by
        intro a b ha hb
        simpa only [Set.mem_setOf_eq, Complex.ofReal_add, add_smul] using T.add_mem ha hb
      neg_mem' := by
        intro a ha
        simpa only [Set.mem_setOf_eq, Complex.ofReal_neg, neg_smul] using T.neg_mem ha }
    have hSclosed : IsClosed (S : Set ℝ) :=
      closed.preimage (show Continuous (fun a : ℝ => (a : ℂ) • v) by fun_prop)
    have hShalf (a : ℝ) (ha : a ∈ S) : a / 2 ∈ S := by
      have hh := halve ((a : ℂ) • v) ha
      change ((a / 2 : ℝ) : ℂ) • v ∈ T
      have he : ((a / 2 : ℝ) : ℂ) = (2 : ℂ)⁻¹ * (a : ℂ) := by
        push_cast
        ring
      rw [he, mul_smul]
      exact hh
    have hSne : S ≠ ⊥ := by
      intro he
      have h1 : (1 : ℝ) ∈ S := by change (1 : ℂ) • v ∈ T; simpa using hv
      rw [he] at h1
      simp at h1
    have hSdense : Dense (S : Set ℝ) := by
      apply S.dense_of_no_min hSne
      rintro ⟨a, ⟨ha, ha0⟩, hmin⟩
      have hle := hmin ⟨hShalf a ha, by linarith⟩
      linarith
    have hr := hSdense r
    rwa [hSclosed.closure_eq] at hr
  rw [← Complex.re_add_im c, add_smul, mul_smul]
  exact T.add_mem (real_mem c.re u hu)
    (real_mem c.im (Complex.I • u) (quarter u hu))

/-- With an operational half, the feature image itself is norm dense.
All closure and scalar continuity used here is in the constructed output. -/
theorem denseRange_feature (half : V →+ V) (halves : ∀ x, half x + half x = x) :
    DenseRange (feature h phase) := by
  let R := (featureHom h phase).range
  let T := R.topologicalClosure
  have hhalve : Set.MapsTo (fun u : Hilbert h phase => (2 : ℂ)⁻¹ • u)
      (R : Set (Hilbert h phase)) R := by
    rintro _ ⟨x, rfl⟩
    exact ⟨half x, feature_half h phase half halves x⟩
  have hquarter : Set.MapsTo (fun u : Hilbert h phase => Complex.I • u)
      (R : Set (Hilbert h phase)) R := by
    rintro _ ⟨x, rfl⟩
    exact ⟨phase.J x, feature_phase h phase x⟩
  have hhalveT : ∀ u ∈ T, (2 : ℂ)⁻¹ • u ∈ T :=
    hhalve.closure (continuous_const_smul _)
  have hquarterT : ∀ u ∈ T, Complex.I • u ∈ T :=
    hquarter.closure (continuous_const_smul _)
  let S : Submodule ℂ (Hilbert h phase) := {
    T.toAddSubmonoid with
    smul_mem' := closed_subgroup_complex_smul h phase T R.isClosed_topologicalClosure
      hhalveT hquarterT }
  have hspan : Submodule.span ℂ (Set.range (feature h phase)) ≤ S := by
    apply Submodule.span_le.mpr
    rintro _ ⟨x, rfl⟩
    exact R.le_topologicalClosure ⟨x, rfl⟩
  have hdense : Dense (S : Set (Hilbert h phase)) := (dense_span_feature h phase).mono hspan
  have hclosed : IsClosed (S : Set (Hilbert h phase)) := R.isClosed_topologicalClosure
  change Dense (Set.range (feature h phase))
  intro u
  have hu := hdense u
  rwa [hclosed.closure_eq] at hu

/-- Scope of this output construction; these roles do not upgrade scientific claims. -/
inductive BoundaryRole where
  | suppliedPositiveRealQuadraticReadout
  | suppliedAdditiveQuadraticPreservingQuarterTurn
  | constructedComplexScalarsAndHilbertCompletion
  | zeroWeightDirectionsIdentified
  | noCarrierScalarOrTopologyPremise
  | denseComplexSpanWithoutCarrierDivisibility
  | denseFeatureImageTheoremUsesOperationalHalf
  | noInjectivityWithoutDefiniteReadout
  | normDensityDoesNotProvePhysicalStateCompleteness
  | doesNotProveAvailabilityOfCompletedStatesRotationsOrAllMaps
  | doesNotProveBornActualizationDynamicsTensorScaleOrFullQM
  | doesNotUpgradeManifestStatus
  deriving DecidableEq, Repr

def boundaryRoles : List BoundaryRole := [
  .suppliedPositiveRealQuadraticReadout,
  .suppliedAdditiveQuadraticPreservingQuarterTurn,
  .constructedComplexScalarsAndHilbertCompletion,
  .zeroWeightDirectionsIdentified,
  .noCarrierScalarOrTopologyPremise,
  .denseComplexSpanWithoutCarrierDivisibility,
  .denseFeatureImageTheoremUsesOperationalHalf,
  .noInjectivityWithoutDefiniteReadout,
  .normDensityDoesNotProvePhysicalStateCompleteness,
  .doesNotProveAvailabilityOfCompletedStatesRotationsOrAllMaps,
  .doesNotProveBornActualizationDynamicsTensorScaleOrFullQM,
  .doesNotUpgradeManifestStatus]

end

end IDT.QMClosure.CanonicalQuadraticHilbert
